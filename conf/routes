# Routes
# This file defines all application routes (Higher priority routes first)
# https://www.playframework.com/documentation/latest/ScalaRouting
# ~~~~


# Routes for Blocks API

GET /blocks/byHeight          controllers.BlocksApiController.getBlocksByHeight()
GET /blocks                   controllers.BlocksApiController.getContractIds()
GET /blocks/all               controllers.BlocksApiController.getAllPoolBlocks()
+ nocsrf
POST /blocks/utxoIds          controllers.BlocksApiController.getPoolBlocksByIds()
GET /blocks/:utxoId           controllers.BlocksApiController.getBlockById(utxoId: String)
GET /blocks/:utxoId/miners    controllers.BlocksApiController.getBlockMinersById(utxoId: String)

# Routes for Collateral API
+ nocsrf
POST /collateral/create       controllers.CollateralApiController.createCollateralUTXO()
GET /collateral/all           controllers.CollateralApiController.getAllCollateralInfo()
GET /collateral/local         controllers.CollateralApiController.getLocalCollateralInfo()

# Routes for Info API

GET /info                     controllers.InfoApiController.getLithosInfo()

# Routes for Mining API

GET /mining/bestNISP          controllers.MiningApiController.getBestNISPAtHeight()
GET /mining                   controllers.MiningApiController.getStratumInfo()

# Routes for LithosDex API
#
# `/dex` is now LithosDex alone; the PlasmaDex routes that shared this prefix were removed with the
# package. Nothing here takes a wildcard in first position, so ordering within this block is free.

GET  /dex/pool                                  controllers.LithosDexApiController.getPool()
GET  /dex/vault                                 controllers.LithosDexApiController.getVault()
GET  /dex/provisions                            controllers.LithosDexApiController.listProvisions()
GET  /dex/fees/history                          controllers.LithosDexApiController.getFeeHistory(from: Option[Int], to: Option[Int], bucket: Option[Int])
GET  /dex/provisions/:boxId/fees/history        controllers.LithosDexApiController.getProvisionFeeHistory(boxId: String, from: Option[Int], to: Option[Int], bucket: Option[Int])
+ nocsrf
POST /dex/swap/check                            controllers.LithosDexApiController.checkSwap()
+ nocsrf
POST /dex/swap/checkOutput                      controllers.LithosDexApiController.checkSwapOutput()
+ nocsrf
POST /dex/swap                                  controllers.LithosDexApiController.swap()
+ nocsrf
POST /dex/deposit/check                         controllers.LithosDexApiController.checkDeposit()
+ nocsrf
POST /dex/deposit                               controllers.LithosDexApiController.deposit()
+ nocsrf
POST /dex/redeem/check                          controllers.LithosDexApiController.checkRedeem()
+ nocsrf
POST /dex/redeem                                controllers.LithosDexApiController.redeem()
+ nocsrf
POST /dex/provisions/:boxId/claim               controllers.LithosDexApiController.claimProvision(boxId: String)
+ nocsrf
POST /dex/provisions/:boxId/resize/check        controllers.LithosDexApiController.checkResize(boxId: String)
+ nocsrf
POST /dex/provisions/:boxId/resize              controllers.LithosDexApiController.resize(boxId: String)
+ nocsrf
POST /dex/flush/check                           controllers.LithosDexApiController.checkFlush()
+ nocsrf
POST /dex/flush                                 controllers.LithosDexApiController.flush()

GET  /wallet/balance                            controllers.LithosDexApiController.getWalletBalance()

# Routes for Payments API

GET /payments                 controllers.PaymentsApiController.getPayments()

# An example controller showing a sample home page
GET     /assets                                   controllers.Assets.at(path="/public", file="index.html")
GET     /                                         controllers.Default.redirect(to = "/assets")


# Map static resources from the /public folder to the /assets URL path
GET /assets/*file controllers.Assets.versioned(path="/public", file: Asset)
GET /assets/docs/intro/*file controllers.Assets.versioned(path="/public", file: Asset)