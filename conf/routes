# Routes
# This file defines all application routes (Higher priority routes first)
# https://www.playframework.com/documentation/latest/ScalaRouting
# ~~~~


# Routes for Blocks API

GET /blocks/byHeight          controllers.BlocksApiController.getBlocksByHeight()
GET /blocks                   controllers.BlocksApiController.getContractIds()
GET /blocks/all               controllers.BlocksApiController.getAllPoolBlocks()
+ nocsrf
POST /blocks/utxoIds          controllers.BlocksApiController.getPoolBlocksByIds()
GET /blocks/:utxoId           controllers.BlocksApiController.getBlockById(utxoId: String)
GET /blocks/:utxoId/miners    controllers.BlocksApiController.getBlockMinersById(utxoId: String)

# Routes for Collateral API
+ nocsrf
POST /collateral/create       controllers.CollateralApiController.createCollateralUTXO()
GET /collateral/all           controllers.CollateralApiController.getAllCollateralInfo()
GET /collateral/local         controllers.CollateralApiController.getLocalCollateralInfo()

# Routes for Info API

GET /info                     controllers.InfoApiController.getLithosInfo()

# Routes for Mining API

GET /mining/bestNISP          controllers.MiningApiController.getBestNISPAtHeight()
GET /mining                   controllers.MiningApiController.getStratumInfo()

# Routes for Dex API

GET  /dex                               controllers.DexApiController.getDexInfo()
+ nocsrf
POST /dex/syncFee/:feeNFTId             controllers.DexApiController.syncFee(feeNFTId: String)
+ nocsrf
POST /dex/claimFee/:feeNFTId            controllers.DexApiController.claimFee(feeNFTId: String)
GET  /dex/:lpId/sync                    controllers.DexApiController.getDexSyncStatus(lpId: String)
+ nocsrf
POST /dex/:lpId/swap/check              controllers.DexApiController.checkSwapDex(lpId: String)
+ nocsrf
POST /dex/:lpId/swap                    controllers.DexApiController.swapDex(lpId: String)
+ nocsrf
POST /dex/:lpId/deposit/check           controllers.DexApiController.checkDepositDex(lpId: String)
+ nocsrf
POST /dex/:lpId/deposit                 controllers.DexApiController.depositDex(lpId: String)
+ nocsrf
POST /dex/:lpId/redemption/check        controllers.DexApiController.checkRedemptionDex(lpId: String)
+ nocsrf
POST /dex/:lpId/redemption              controllers.DexApiController.redemptionDex(lpId: String)
+ nocsrf
POST /dex/:lpId/withdraw/check          controllers.DexApiController.checkWithdrawDex(lpId: String)
+ nocsrf
POST /dex/:lpId/withdraw                controllers.DexApiController.withdrawDex(lpId: String)

# Routes for Payments API

GET /payments                 controllers.PaymentsApiController.getPayments()

# An example controller showing a sample home page
GET     /assets                                   controllers.Assets.at(path="/public", file="index.html")
GET     /                                         controllers.Default.redirect(to = "/assets")


# Map static resources from the /public folder to the /assets URL path
GET /assets/*file controllers.Assets.versioned(path="/public", file: Asset)
GET /assets/docs/intro/*file controllers.Assets.versioned(path="/public", file: Asset)