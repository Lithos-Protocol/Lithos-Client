# Web panel and docs, a Docusaurus build in /public served at /assets. Page URLs resolve to their
# index.html, so a refresh or a pasted link works as well as following one.
GET     /assets                                   controllers.WebPanelController.page(file = "")
GET     /                                         controllers.Default.redirect(to = "/assets")
GET     /assets/*file                             controllers.WebPanelController.page(file: String)
