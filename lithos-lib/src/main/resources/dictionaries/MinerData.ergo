{
  // MinerData Contract
  // Value: 0.001 ERG
  // MinerData box holds information about the miner, including diff commitments, balance, and options
  // REGISTERS
  // R4: commitments - Difficulty commitments, there can be a maximum of 2 commitments at any given point.
  // Each element maps (commitHeight -> score)
  // Commitment height must be at least NISP_WINDOW blocks in the future from the spending of this box.
  // As this transaction may take time in the mempool, it is best to have a buffer above NISP_WINDOW blocks.
  // The second element always represents the old commitment, while the first element represents the newest one.
  // R5: options - Serialized optional settings, can be used for extensions. First 32 bytes are hash of miner prop bytes
  val minerDataUTXO = SELF
  val commitments: Coll[(Int, Long)] = minerDataUTXO.R4[Coll[(Int, Long)]].get
  val options: Coll[Byte] = minerDataUTXO.R5[Coll[Byte]].get
  val minerHash: Coll[Byte] = options.slice(0, 32)
  // TODO: Add spending by anyone to payout balance above min payment
  // TODO: Use executeFromVar instead of SigmaProp for CTX_SIGNER, to allow for more composability
  // CONTEXT VARS
  // CTX_OP(0): Operation performed on the tree
  // CTX_SIGNER(1): Miner performing the operation
  val CTX_OP      = getVar[Byte](0).get
  val CTX_SIGNER  = getVar[SigmaProp](1).get

  val changeDiffOp    = CTX_OP  == 0.toByte
  val payoutBalanceOp = CTX_OP  == 1.toByte
  val removeMinerOp   = CTX_OP  == 2.toByte

  // CONSTANTS
  // CONST_MIN_DATA_BOX_AMNT: Minimum amount of ERG required for data box
  // CONST_NISP_WINDOW: NISP Window, used here as `r` parameter, defining number of rounds/blocks before commitments
  // may take affect and new commitments may be made.
  // CONST_MD_ID: Id of MinerDictionary nft
  // Spending Path 1: MinerData UTXO is spent to add new diff commitment
  if(changeDiffOp){
    val nextUTXO = OUTPUTS(0)
    val onlyOne = SELF.id == INPUTS(0).id
    val authenticMiner  = blake2b256( CTX_SIGNER.propBytes ) == minerHash
    val validUTXO       = nextUTXO.propositionBytes == SELF.propositionBytes
    val valueConserved  = nextUTXO.value == SELF.value
    val tokensConserved = nextUTXO.tokens == SELF.tokens
    val optionsConserved = nextUTXO.R5[Coll[Byte]].get == options
    val nextCommitments = nextUTXO.R4[Coll[(Int, Long)]].get

    val correctCommit = {
      if(commitments.size == 1 || commitments.size == 2){
        allOf(
          Coll(
            nextCommitments.size == 2,
            nextCommitments(1) == commitments(0),
            HEIGHT - commitments(0)._1 >= CONST_NISP_WINDOW, // It has been at least NISP_WINDOW blocks since last commit
            nextCommitments(0)._1 - HEIGHT >= CONST_NISP_WINDOW // Next commitment will take place at least NISP_WINDOW blocks in the future
          )
        )
      }else{
        false // Should always spend to create two commits, one commit is only possible on initialization of the box
      }
    }
    val statements = allOf(
      Coll(
        onlyOne,
        authenticMiner,
        validUTXO,
        valueConserved,
        tokensConserved,
        optionsConserved,
        correctCommit
      )
    )

    sigmaProp(statements) && CTX_SIGNER
    // Spending Path 2: Miner Data UTXO is spent to payout balance
  }else if(payoutBalanceOp){
    val nextUTXO = OUTPUTS(0)
    val onlyOne = SELF.id == INPUTS(0).id
    val authenticMiner  = blake2b256( CTX_SIGNER.propBytes ) == minerHash
    val validUTXO       = nextUTXO.propositionBytes == SELF.propositionBytes
    val valueAboveMin   = nextUTXO.value >= CONST_MIN_DATA_BOX_AMNT
    val tokensConserved = nextUTXO.tokens == SELF.tokens
    val optionsConserved = nextUTXO.R5[Coll[Byte]].get == options
    val commitsConserved = nextUTXO.R4[Coll[(Int, Long)]].get == commitments
    val statements = allOf(
      Coll(
        onlyOne,
        authenticMiner,
        validUTXO,
        valueAboveMin,
        tokensConserved,
        optionsConserved,
        commitsConserved
      )
    )
    sigmaProp(statements) && CTX_SIGNER
    // Spending Path 3: Miner Data UTXO is spent to remove miner from Miner Dictionary
  }else if(removeMinerOp){
    // Verify correct MinerDictionary UTXO is being used
    val authenticDictionary = blake2b256(INPUTS(0).tokens(0)._1) == CONST_MD_ID
    val authenticSigner = blake2b256( CTX_SIGNER.propBytes ) == minerHash
    // Check signer is correct and two inputs used, rest is handled by miner dictionary
    sigmaProp( authenticDictionary && authenticSigner && INPUTS.size == 2) && CTX_SIGNER

  }else{
    sigmaProp(false)
  }
}