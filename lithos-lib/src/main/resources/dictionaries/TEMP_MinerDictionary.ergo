{
  // MinerDictionary Contract
  // Value: singleton state-box reserve
  // Maps miner identities to credential ids and bounded Data/Bond validity and exit state.

  // REGISTERS
  // R4: minerDataTree - minerHash -> [credentialId:32][validUntil:8][exitAt:8][status:1]
  val minerDataTree = SELF.R4[AvlTree].get

  // CONSTANTS
  // CONST_MINERDATA_PROPBYTES: hashed proposition bytes of MinerData
  // CONST_MINERBOND_PROPBYTES: hashed proposition bytes of MinerBond
  // CONST_MIN_DATA_BOX_AMNT: MinerData ERG reserve
  // CONST_BOND_STAKE_ERG: slashable ERG amount
  // CONST_BOND_STAKE_LIT: slashable LIT base-unit amount
  // CONST_BOND_RESERVE_ERG: ERG retained by a slashed marker
  // CONST_LIT_ID: LIT token id
  // CONST_NISP_WINDOW: delay before the first commitment takes effect
  // CONST_DATA_LIFETIME: three-year lifetime in blocks, 788400 at two-minute blocks
  // CONST_WITHDRAW_DELAY: exit delay, 880 blocks
  val CONST_ENTRY_SIZE = 49
  val CONST_MAX_EXT_SIZE = 512

  // CONTEXT VARS
  // CTX_OP(0): 0 register, 1 request exit, 2 renew, 3 complete exit
  val CTX_OP = getVar[Byte](0).getOrElse((-1).toByte)

  // NEXT VALUES
  val nextUTXO = OUTPUTS(0)
  val nextTree = nextUTXO.R4[AvlTree].get

  def makeEntry(credentialId: Coll[Byte], validUntil: Long, exitAt: Long, status: Byte): Coll[Byte] = {
    credentialId
      .append(longToByteArray(validUntil))
      .append(longToByteArray(exitAt))
      .append(Coll(status))
  }

  def credentialOf(entry: Coll[Byte]): Coll[Byte] = entry.slice(0, 32)
  def validUntilOf(entry: Coll[Byte]): Long = byteArrayToLong(entry.slice(32, 40))
  def exitAtOf(entry: Coll[Byte]): Long = byteArrayToLong(entry.slice(40, 48))
  def statusOf(entry: Coll[Byte]): Byte = entry.getOrElse(48, (-1).toByte)

  def totalInOutputs(tokenId: Coll[Byte]): Long = {
    OUTPUTS.fold(0L, {
      (a: Long, b: Box) =>
        val inBox = b.tokens.fold(0L, {
          (z: Long, t: (Coll[Byte], Long)) =>
            if(t._1 == tokenId) z + t._2 else z
        })
        a + inBox
    })
  }

  val onlyOne = SELF.id == INPUTS(0).id
  val validUTXO = nextUTXO.propositionBytes == SELF.propositionBytes
  val singletonConserved = allOf(Coll(
    nextUTXO.value == SELF.value,
    nextUTXO.tokens == SELF.tokens,
    nextUTXO.R5[Coll[Byte]].isEmpty,
    nextTree.isInsertAllowed == minerDataTree.isInsertAllowed,
    nextTree.isUpdateAllowed == minerDataTree.isUpdateAllowed,
    nextTree.isRemoveAllowed == minerDataTree.isRemoveAllowed,
    nextTree.keyLength == minerDataTree.keyLength,
    nextTree.valueLengthOpt == minerDataTree.valueLengthOpt
  ))

  // ASSUMPTIONS - statements which can be assumed to be true due to this box's genesis
  // SELF carries the MinerDictionary singleton NFT and R4 is an all-operations AVL tree with 32-byte
  // keys and 49-byte values. Every path preserves the NFT, script and tree metadata.
  // A credential id is the registration dictionary input id. Ergo minting therefore makes it unique,
  // and the registration path pins its total output supply to exactly two units.
  // The entry remains in exiting state for 880 blocks. This delays both credential destruction and
  // stake withdrawal until every promptly-transitioned rollup can finish evaluation.
  //
  // DELIBERATE OMISSIONS - conditions left out on purpose
  // Expired entries are not removed permissionlessly. The miner may request exit even after expiry,
  // but their signature remains necessary to recover MinerData balances.

  if(CTX_OP == 0.toByte){
    // Spending Path 1: Register MinerData and MinerBond and mint exactly two credential units
    val CTX_SIGNER = getVar[SigmaProp](1).get
    val CTX_SCORE = getVar[Long](2).get
    val CTX_EFFECTIVE_HEIGHT = getVar[Int](3).get
    val CTX_INSERT_PROOF = getVar[Coll[Byte]](4).get
    val CTX_EXTENSIONS = getVar[Coll[Byte]](5).getOrElse(Coll[Byte]())

    val minerHash = blake2b256(CTX_SIGNER.propBytes)
    val credentialId = SELF.id
    val validUntil = HEIGHT.toLong + CONST_DATA_LIFETIME
    val entry = makeEntry(credentialId, validUntil, 0L, 0.toByte)
    val dataBox = OUTPUTS(1)
    val bondBox = OUTPUTS(2)

    val treeUpdated = {
      val insertTree = minerDataTree.insert(Coll((minerHash, entry)), CTX_INSERT_PROOF).get
      insertTree.digest == nextTree.digest
    }
    val validDataBox = allOf(Coll(
      blake2b256(dataBox.propositionBytes) == CONST_MINERDATA_PROPBYTES,
      dataBox.value == CONST_MIN_DATA_BOX_AMNT,
      dataBox.tokens.size == 1,
      dataBox.tokens(0)._1 == credentialId,
      dataBox.tokens(0)._2 == 1L,
      dataBox.R4[Coll[(Int, Long)]].get == Coll((CTX_EFFECTIVE_HEIGHT, CTX_SCORE)),
      dataBox.R5[Coll[Byte]].get == minerHash,
      dataBox.R6[Coll[Byte]].get == CTX_EXTENSIONS,
      dataBox.R7[Coll[Byte]].isEmpty,
      dataBox.creationInfo._1 == HEIGHT
    ))
    val validBondBox = allOf(Coll(
      blake2b256(bondBox.propositionBytes) == CONST_MINERBOND_PROPBYTES,
      bondBox.value == CONST_BOND_STAKE_ERG + CONST_BOND_RESERVE_ERG,
      bondBox.tokens.size == 2,
      bondBox.tokens(0)._1 == credentialId,
      bondBox.tokens(0)._2 == 1L,
      bondBox.tokens(1)._1 == CONST_LIT_ID,
      bondBox.tokens(1)._2 == CONST_BOND_STAKE_LIT,
      bondBox.R4[Coll[Byte]].get == minerHash,
      bondBox.R5[Byte].get == 0.toByte,
      bondBox.R6[Long].get == 0L,
      bondBox.R7[Coll[Byte]].isEmpty,
      bondBox.creationInfo._1 == HEIGHT
    ))
    val validInitialState = allOf(Coll(
      minerHash.size == 32,
      entry.size == CONST_ENTRY_SIZE,
      CTX_SCORE > 0L,
      CTX_EFFECTIVE_HEIGHT.toLong >= HEIGHT.toLong + CONST_NISP_WINDOW,
      CTX_EXTENSIONS.size <= CONST_MAX_EXT_SIZE,
      totalInOutputs(credentialId) == 2L
    ))
    val statements = allOf(Coll(
      onlyOne,
      validUTXO,
      singletonConserved,
      validInitialState,
      validDataBox,
      validBondBox,
      treeUpdated
    ))
    sigmaProp(statements) && CTX_SIGNER

  }else if(CTX_OP == 1.toByte){
    // Spending Path 2: The miner requests exit; the entry remains provable during the delay
    val CTX_SIGNER = getVar[SigmaProp](1).get
    val CTX_LOOKUP_PROOF = getVar[Coll[Byte]](2).get
    val CTX_UPDATE_PROOF = getVar[Coll[Byte]](3).get
    val minerHash = blake2b256(CTX_SIGNER.propBytes)
    val oldEntryOpt = minerDataTree.get(minerHash, CTX_LOOKUP_PROOF)

    if(oldEntryOpt.isDefined){
      val oldEntry = oldEntryOpt.get
      val nextEntry = makeEntry(
        credentialOf(oldEntry),
        validUntilOf(oldEntry),
        HEIGHT.toLong + CONST_WITHDRAW_DELAY,
        1.toByte
      )
      val treeUpdated = {
        val updateTree = minerDataTree.update(Coll((minerHash, nextEntry)), CTX_UPDATE_PROOF).get
        updateTree.digest == nextTree.digest
      }
      val validEntry = allOf(Coll(
        oldEntry.size == CONST_ENTRY_SIZE,
        statusOf(oldEntry) == 0.toByte,
        exitAtOf(oldEntry) == 0L,
        credentialOf(oldEntry).size == 32
      ))
      val statements = allOf(Coll(
        onlyOne,
        validUTXO,
        singletonConserved,
        validEntry,
        treeUpdated
      ))
      sigmaProp(statements) && CTX_SIGNER
    }else{
      sigmaProp(false)
    }

  }else if(CTX_OP == 2.toByte){
    // Spending Path 3: Renew before expiry and recreate Data/Bond to reset storage-rent age
    val CTX_SIGNER = getVar[SigmaProp](1).get
    val CTX_LOOKUP_PROOF = getVar[Coll[Byte]](2).get
    val CTX_UPDATE_PROOF = getVar[Coll[Byte]](3).get
    val minerHash = blake2b256(CTX_SIGNER.propBytes)
    val oldEntryOpt = minerDataTree.get(minerHash, CTX_LOOKUP_PROOF)

    if(oldEntryOpt.isDefined){
      val oldEntry = oldEntryOpt.get
      val credentialId = credentialOf(oldEntry)
      val dataBox = INPUTS(1)
      val bondBox = INPUTS(2)
      val nextData = OUTPUTS(1)
      val nextBond = OUTPUTS(2)
      val nextEntry = makeEntry(
        credentialId,
        HEIGHT.toLong + CONST_DATA_LIFETIME,
        0L,
        0.toByte
      )
      val treeUpdated = {
        val updateTree = minerDataTree.update(Coll((minerHash, nextEntry)), CTX_UPDATE_PROOF).get
        updateTree.digest == nextTree.digest
      }
      val validEntry = allOf(Coll(
        oldEntry.size == CONST_ENTRY_SIZE,
        statusOf(oldEntry) == 0.toByte,
        exitAtOf(oldEntry) == 0L,
        HEIGHT.toLong < validUntilOf(oldEntry)
      ))
      val authenticInputs = allOf(Coll(
        INPUTS.size >= 3,
        blake2b256(dataBox.propositionBytes) == CONST_MINERDATA_PROPBYTES,
        dataBox.tokens.getOrElse(0, (Coll(0.toByte), 0L))._1 == credentialId,
        dataBox.R5[Coll[Byte]].get == minerHash,
        blake2b256(bondBox.propositionBytes) == CONST_MINERBOND_PROPBYTES,
        bondBox.tokens.getOrElse(0, (Coll(0.toByte), 0L))._1 == credentialId,
        bondBox.R4[Coll[Byte]].get == minerHash,
        bondBox.R5[Byte].get == 0.toByte
      ))
      val dataRenewed = allOf(Coll(
        nextData.propositionBytes == dataBox.propositionBytes,
        nextData.value == dataBox.value,
        nextData.tokens == dataBox.tokens,
        nextData.R4[Coll[(Int, Long)]].get == dataBox.R4[Coll[(Int, Long)]].get,
        nextData.R5[Coll[Byte]].get == minerHash,
        nextData.R6[Coll[Byte]].get == dataBox.R6[Coll[Byte]].get,
        nextData.R7[Coll[Byte]].isEmpty,
        nextData.creationInfo._1 == HEIGHT
      ))
      val bondRenewed = allOf(Coll(
        nextBond.propositionBytes == bondBox.propositionBytes,
        nextBond.value == bondBox.value,
        nextBond.tokens == bondBox.tokens,
        nextBond.R4[Coll[Byte]].get == minerHash,
        nextBond.R5[Byte].get == 0.toByte,
        nextBond.R6[Long].get == 0L,
        nextBond.R7[Coll[Byte]].isEmpty,
        nextBond.creationInfo._1 == HEIGHT
      ))
      val statements = allOf(Coll(
        onlyOne,
        validUTXO,
        singletonConserved,
        validEntry,
        authenticInputs,
        dataRenewed,
        bondRenewed,
        treeUpdated
      ))
      sigmaProp(statements) && CTX_SIGNER
    }else{
      sigmaProp(false)
    }

  }else if(CTX_OP == 3.toByte){
    // Spending Path 4: After 880 blocks, remove the entry and burn both credential units
    val CTX_SIGNER = getVar[SigmaProp](1).get
    val CTX_LOOKUP_PROOF = getVar[Coll[Byte]](2).get
    val CTX_REMOVE_PROOF = getVar[Coll[Byte]](3).get
    val minerHash = blake2b256(CTX_SIGNER.propBytes)
    val oldEntryOpt = minerDataTree.get(minerHash, CTX_LOOKUP_PROOF)

    if(oldEntryOpt.isDefined){
      val oldEntry = oldEntryOpt.get
      val credentialId = credentialOf(oldEntry)
      val dataBox = INPUTS(1)
      val bondBox = INPUTS(2)
      val treeUpdated = {
        val removeTree = minerDataTree.remove(Coll(minerHash), CTX_REMOVE_PROOF).get
        removeTree.digest == nextTree.digest
      }
      val authenticInputs = allOf(Coll(
        INPUTS.size >= 3,
        blake2b256(dataBox.propositionBytes) == CONST_MINERDATA_PROPBYTES,
        dataBox.tokens.getOrElse(0, (Coll(0.toByte), 0L))._1 == credentialId,
        dataBox.R5[Coll[Byte]].get == minerHash,
        blake2b256(bondBox.propositionBytes) == CONST_MINERBOND_PROPBYTES,
        bondBox.tokens.getOrElse(0, (Coll(0.toByte), 0L))._1 == credentialId,
        bondBox.R4[Coll[Byte]].get == minerHash
      ))
      val exitReady = allOf(Coll(
        oldEntry.size == CONST_ENTRY_SIZE,
        statusOf(oldEntry) == 1.toByte,
        HEIGHT.toLong >= exitAtOf(oldEntry),
        totalInOutputs(credentialId) == 0L
      ))
      val statements = allOf(Coll(
        onlyOne,
        validUTXO,
        singletonConserved,
        authenticInputs,
        exitReady,
        treeUpdated
      ))
      sigmaProp(statements) && CTX_SIGNER
    }else{
      sigmaProp(false)
    }

  }else{
    sigmaProp(false)
  }
}
