{
  // MinerBond Contract
  // Value: 0.5 ERG slash stake plus a small marker/storage reserve
  // Separates the slashable stake from MinerData balances and leaves an authenticated slashed marker.

  // REGISTERS
  // R4: minerHash - blake2b256 of the miner's proposition bytes
  // R5: status - 0 active bond, 1 slashed marker
  // R6: eventHeight - zero while active, slash height after slashing
  val minerHash   = SELF.R4[Coll[Byte]].get
  val status      = SELF.R5[Byte].get
  val eventHeight = SELF.R6[Long].get
  val credential  = SELF.tokens.getOrElse(0, (Coll(0.toByte), 0L))

  // CONSTANTS
  // CONST_EVAL_PROPBYTES: hashed proposition bytes of the authenticated Evaluation contract
  // CONST_COLLAT_TOKEN_ID: fixed collateral proposition token carried by genuine rollups
  // CONST_MD_ID: MinerDictionary singleton NFT id
  // CONST_LIT_ID: LIT token id
  // CONST_BOND_STAKE_ERG: slashable ERG amount, 0.5 ERG
  // CONST_BOND_STAKE_LIT: slashable LIT base-unit amount, economically 30 LIT
  // CONST_BOND_RESERVE_ERG: ERG retained by the slashed marker
  // CONST_WITHDRAW_DELAY: maximum rollup safety delay, 880 blocks

  // CONTEXT VARS
  // CTX_OP(0): 0 slash, 1 dictionary renewal, 2 dictionary final exit
  val CTX_OP = getVar[Byte](0).getOrElse((-1).toByte)

  val activeValue = CONST_BOND_STAKE_ERG + CONST_BOND_RESERVE_ERG
  val validIdentity = minerHash.size == 32
  val validCredential = credential._1.size == 32 && credential._2 == 1L
  val boundedRegisters = SELF.R7[Coll[Byte]].isEmpty

  // ASSUMPTIONS - statements which can be assumed to be true due to other contracts enforcing them
  // during creation of this UTXO
  // MinerDictionary creates this box with one of exactly two credential units; MinerData holds the other.
  // Evaluation authenticates the credential against MinerDictionary and binds INPUTS(2).R4 to the fraud-
  // proof miner key before allowing an ordinary proof to execute.
  // The genuine Evaluation input carries CONST_COLLAT_TOKEN_ID, so an attacker cannot fabricate a rollup
  // with a fake NISP tree and use it to slash a real bond.
  //
  // DELIBERATE OMISSIONS - conditions left out on purpose
  // The slasher chooses any proposition bytes for the reward output. This is permissionless by design.

  if(CTX_OP == 0.toByte){
    // Spending Path 1: A successful ordinary fraud proof transfers only the stake to the slasher
    val CTX_SLASHER_PROPBYTES = getVar[Coll[Byte]](1).get
    val evalBox = INPUTS(0)
    val marker = OUTPUTS(1)
    val reward = OUTPUTS(2)
    val proofMiner = getVarFromInput[Coll[Byte]](1, 0).getOrElse(Coll(0.toByte))
    val litStake = SELF.tokens.getOrElse(1, (Coll(0.toByte), 0L))

    val authenticEvaluation = allOf(Coll(
      blake2b256(evalBox.propositionBytes) == CONST_EVAL_PROPBYTES,
      evalBox.tokens.exists{ (t: (Coll[Byte], Long)) =>
        t._1 == CONST_COLLAT_TOKEN_ID && t._2 == 1L
      }
    ))
    val correctPosition = INPUTS.size == 3 && SELF.id == INPUTS(2).id
    val activeBond = allOf(Coll(
      status == 0.toByte,
      eventHeight == 0L,
      SELF.value == activeValue,
      SELF.tokens.size == 2,
      litStake._1 == CONST_LIT_ID,
      litStake._2 == CONST_BOND_STAKE_LIT,
      proofMiner == minerHash
    ))
    val validMarker = allOf(Coll(
      marker.propositionBytes == SELF.propositionBytes,
      marker.value == CONST_BOND_RESERVE_ERG,
      marker.tokens.size == 1,
      marker.tokens(0) == credential,
      marker.R4[Coll[Byte]].get == minerHash,
      marker.R5[Byte].get == 1.toByte,
      marker.R6[Long].get == HEIGHT.toLong,
      marker.R7[Coll[Byte]].isEmpty,
      marker.creationInfo._1 == HEIGHT
    ))
    val slasherPaid = allOf(Coll(
      CTX_SLASHER_PROPBYTES.size > 0,
      reward.propositionBytes == CTX_SLASHER_PROPBYTES,
      reward.value == CONST_BOND_STAKE_ERG,
      reward.tokens.size == 1,
      reward.tokens(0)._1 == CONST_LIT_ID,
      reward.tokens(0)._2 == CONST_BOND_STAKE_LIT
    ))
    val statements = allOf(Coll(
      authenticEvaluation,
      correctPosition,
      activeBond,
      validIdentity,
      validCredential,
      boundedRegisters,
      validMarker,
      slasherPaid
    ))
    sigmaProp(statements)

  }else if(CTX_OP == 1.toByte){
    // Spending Path 2: MinerDictionary renews the active bond and resets its storage-rent age
    val CTX_SIGNER = getVar[SigmaProp](1).get
    val nextUTXO = OUTPUTS(2)
    val authenticDictionary = INPUTS(0).tokens.getOrElse(0, (Coll(0.toByte), 0L))._1 == CONST_MD_ID
    val authenticMiner = blake2b256(CTX_SIGNER.propBytes) == minerHash
    val correctPosition = INPUTS.size >= 3 && SELF.id == INPUTS(2).id
    val activeBond = allOf(Coll(
      status == 0.toByte,
      eventHeight == 0L,
      SELF.value == activeValue,
      SELF.tokens.size == 2,
      SELF.tokens(1)._1 == CONST_LIT_ID,
      SELF.tokens(1)._2 == CONST_BOND_STAKE_LIT
    ))
    val stateConserved = allOf(Coll(
      nextUTXO.propositionBytes == SELF.propositionBytes,
      nextUTXO.value == SELF.value,
      nextUTXO.tokens == SELF.tokens,
      nextUTXO.R4[Coll[Byte]].get == minerHash,
      nextUTXO.R5[Byte].get == status,
      nextUTXO.R6[Long].get == eventHeight,
      nextUTXO.R7[Coll[Byte]].isEmpty,
      nextUTXO.creationInfo._1 == HEIGHT
    ))
    val statements = allOf(Coll(
      authenticDictionary,
      authenticMiner,
      correctPosition,
      activeBond,
      validIdentity,
      validCredential,
      boundedRegisters,
      stateConserved
    ))
    sigmaProp(statements) && CTX_SIGNER

  }else if(CTX_OP == 2.toByte){
    // Spending Path 3: MinerDictionary completes a delayed exit and burns this credential unit
    val CTX_SIGNER = getVar[SigmaProp](1).get
    val authenticDictionary = INPUTS(0).tokens.getOrElse(0, (Coll(0.toByte), 0L))._1 == CONST_MD_ID
    val authenticMiner = blake2b256(CTX_SIGNER.propBytes) == minerHash
    val correctPosition = INPUTS.size >= 3 && SELF.id == INPUTS(2).id
    val validStatus = status == 0.toByte || status == 1.toByte
    val markerDelayPassed = {
      if(status == 1.toByte)
        HEIGHT.toLong >= eventHeight + CONST_WITHDRAW_DELAY
      else
        true
    }
    val statements = allOf(Coll(
      authenticDictionary,
      authenticMiner,
      correctPosition,
      validStatus,
      markerDelayPassed,
      validIdentity,
      validCredential,
      boundedRegisters
    ))
    sigmaProp(statements) && CTX_SIGNER

  }else{
    sigmaProp(false)
  }
}
