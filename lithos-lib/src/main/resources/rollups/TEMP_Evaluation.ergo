{
  // TEMP Evaluation Contract - refundable score bond revision
  // Value: block reward plus refundable bonds belonging to the NISPs still in R4.

  // REGISTERS
  // R4: NISP tree
  // R5: remaining miners
  // R6: remaining total score
  // R7: evaluation period start
  // R8: height of the block whose rollup is being evaluated
  // R9: total refundable ERG bond belonging to remaining NISPs
  val nispTree = SELF.R4[AvlTree].get
  val currentMiners = SELF.R5[Int].get
  val totalScore = SELF.R6[BigInt].get
  val currentPeriod = SELF.R7[Long].get
  val totalBond = SELF.R9[Long].get

  // CONSTANTS
  // CONST_PERIOD_LENGTH: evaluation phase length
  // CONST_PAYOUT_PROPBYTES: hashed proposition bytes of the Payout contract
  // CONST_FP_ID: singleton token authenticating the fraud-proof whitelist
  // CONST_MIN_ENTRY_BOND: minimum refundable bond, 0.002 ERG at launch
  // CONST_BOND_DIVISOR: score units per nanoERG of proportional bond, 100 at launch

  val nextUTXO = OUTPUTS(0)
  val nextTree = nextUTXO.R4[AvlTree].get
  val nextMiners = nextUTXO.R5[Int].get
  val nextScore = nextUTXO.R6[BigInt].get
  val nextPeriod = nextUTXO.R7[Long].get
  val nextBond = nextUTXO.R9[Long].get

  // ASSUMPTIONS
  // Holding creates this box with R9 equal to the sum of bondForScore(score) for every NISP in R4.
  // Whitelisted fraud proofs establish which miner and score were removed. This contract centrally
  // enforces the corresponding ERG slash, R9 decrement and prover payment, so the bond formula does
  // not have to be duplicated across every fraud-proof script.
  // INPUTS(1) is the prover-controlled input carrying fraud-proof context variables. Its proposition
  // is also the recipient of the slashed bond. The prover input funds the transaction fee.

  def bondForScore(score: Long): Long = {
    val proportional = score / CONST_BOND_DIVISOR
    if(proportional > CONST_MIN_ENTRY_BOND) proportional else CONST_MIN_ENTRY_BOND
  }

  val onlyOne = SELF.id == INPUTS(0).id

  // Spending Path 1: remove one fraudulent NISP and pay its complete bond to the prover.
  if(HEIGHT < currentPeriod + CONST_PERIOD_LENGTH){
    val fpData = CONTEXT.dataInputs(0)
    val authenticFPData = fpData.tokens(0)._1 == CONST_FP_ID
    val script = getVar[Coll[Byte]](0).getOrElse(Coll(0.toByte))
    val fpSet = fpData.R4[Coll[Coll[Byte]]].get
    val validFP = fpSet.exists{
      (x: Coll[Byte]) => x == blake2b256(script)
    }

    val removedScore = (totalScore - nextScore).toLong
    val slashedBond = bondForScore(removedScore)

    val proverInput = INPUTS(1)
    val rewardOutput = OUTPUTS(1)
    val correctInputs = INPUTS.size == 2
    val proverPaid = allOf(Coll(
      rewardOutput.propositionBytes == proverInput.propositionBytes,
      rewardOutput.value == slashedBond
    ))

    val contractSame = SELF.propositionBytes == nextUTXO.propositionBytes
    val valueSlashed = nextUTXO.value == SELF.value - slashedBond
    val bondSlashed = nextBond == totalBond - slashedBond
    val tokensConserved = SELF.tokens == nextUTXO.tokens
    val flagsConserved = allOf(Coll(
      nextTree.isInsertAllowed,
      nextTree.isUpdateAllowed,
      nextTree.isRemoveAllowed,
      nextTree.keyLength == nispTree.keyLength,
      nextTree.valueLengthOpt == nispTree.valueLengthOpt
    ))

    val validSlash = allOf(Coll(
      authenticFPData,
      validFP,
      onlyOne,
      correctInputs,
      valueSlashed,
      bondSlashed,
      proverPaid,
      contractSame,
      tokensConserved,
      flagsConserved
    ))

    sigmaProp(validSlash) && executeFromVar[SigmaProp](0)
  }else{
    // Spending Path 2: preserve remaining bonds and expose only the original reward as Payout R7.
    val tokenReward = SELF.tokens.getOrElse(0, (Coll(0.toByte), 0L))._2
    val baseReward = SELF.value - totalBond
    val isPayoutContract = blake2b256(nextUTXO.propositionBytes) == CONST_PAYOUT_PROPBYTES
    val conservedValues = allOf(Coll(
      nextUTXO.value == SELF.value,
      nextUTXO.tokens == SELF.tokens,
      nextTree == nispTree,
      nextMiners == currentMiners,
      nextScore == totalScore,
      nextPeriod == baseReward,
      nextUTXO.R8[Long].get == tokenReward,
      nextBond == totalBond,
      onlyOne
    ))

    sigmaProp(isPayoutContract && conservedValues)
  }
}
