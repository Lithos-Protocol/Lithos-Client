{
  // TEMP Payout Contract - refundable score bond revision
  // Value: unpaid proportional ERG rewards plus the refundable bonds of unpaid miners.

  // REGISTERS
  // R4: remaining NISP tree
  // R5: original valid-miner count, constant during payout
  // R6: original valid total score, constant during payout
  // R7: original block reward only; refundable bonds are deliberately excluded
  // R8: original LIT reward
  // R9: refundable ERG bond remaining for entries still present in R4
  val nispTree = SELF.R4[AvlTree].get
  val currentMiners = SELF.R5[Int].get
  val totalScore = SELF.R6[BigInt].get
  val totalReward = SELF.R7[Long].get
  val tokenReward = SELF.R8[Long].get
  val totalBond = SELF.R9[Long].get
  val totalTokens = SELF.tokens.getOrElse(0, (Coll(0.toByte), 0L))

  // CONSTANTS
  // CONST_FEE_HASH: hashed proposition bytes of the 720-block miner-fee contract
  // CONST_MIN_ENTRY_BOND: minimum refundable bond, 0.002 ERG at launch
  // CONST_BOND_DIVISOR: score units per nanoERG of proportional bond, 100 at launch

  // CONTEXT VARS
  // CTX_KEY_DATA(0): miner keys to pay and remove
  // CTX_LOOKUP_PROOF(1): AVL lookup proof
  // CTX_REMOVE_PROOF(2): AVL removal proof
  val CTX_KEY_DATA = getVar[Coll[Coll[Byte]]](0).getOrElse(Coll(Coll(0.toByte)))
  val CTX_LOOKUP_PROOF = getVar[Coll[Byte]](1).getOrElse(Coll(0.toByte))
  val CTX_REMOVE_PROOF = getVar[Coll[Byte]](2).getOrElse(Coll(0.toByte))

  // ASSUMPTIONS
  // Evaluation creates R7 as SELF.value - R9, so deposits never increase proportional rewards.
  // Holding admitted each NISP only after collecting exactly bondForScore(score), and every successful
  // fraud proof removed both that entry and that bond. Therefore each remaining tree entry owns one
  // exact refund derived from its first eight NISP bytes.
  // Payout may pay several miners at once. A terminal spend is allowed only when the selected miners
  // own all remaining R9, preventing a dust branch from absorbing another miner's refund.

  def bondForScore(score: Long): Long = {
    val proportional = score / CONST_BOND_DIVISOR
    if(proportional > CONST_MIN_ENTRY_BOND) proportional else CONST_MIN_ENTRY_BOND
  }

  // Spending Path 1: an empty rollup can be swept, but no refundable bond may remain.
  if(currentMiners == 0){
    val hasFeeOutput = OUTPUTS.exists{
      (box: Box) => blake2b256(box.propositionBytes) == CONST_FEE_HASH
    }
    val onlyOne = SELF.id == INPUTS(0).id
    val noFeeOutput = !hasFeeOutput
    val noBondLiability = totalBond == 0L
    sigmaProp(noFeeOutput && noBondLiability && onlyOne)
  }else{
    val minersToPay = CTX_KEY_DATA.zip(
      nispTree.getMany(CTX_KEY_DATA, CTX_LOOKUP_PROOF).map{
        (x: Option[Coll[Byte]]) => x.get
      }
    )
    val minersWithScore = minersToPay.map{
      (x: (Coll[Byte], Coll[Byte])) => (x._1, byteArrayToLong(x._2.slice(0, 8)))
    }
    val minersWithBond = minersWithScore.map{
      (x: (Coll[Byte], Long)) => (x._1, bondForScore(x._2))
    }
    val minersWithReward = minersWithScore.map{
      (x: (Coll[Byte], Long)) =>
        val proportional = (totalReward.toBigInt * x._2.toBigInt) / totalScore
        val refund = bondForScore(x._2).toBigInt
        (x._1, proportional + refund)
    }
    val minersWithTokens = minersWithScore.map{
      (x: (Coll[Byte], Long)) =>
        (x._1, ((tokenReward.toBigInt * x._2.toBigInt) / totalScore).toLong)
    }

    val totalMinerRewards = minersWithReward.fold(0.toBigInt, {
      (accum: BigInt, x: (Coll[Byte], BigInt)) => accum + x._2
    })
    val totalTokenRewards = minersWithTokens.fold(0L, {
      (accum: Long, x: (Coll[Byte], Long)) => accum + x._2
    })
    val totalBondRefunds = minersWithBond.fold(0.toBigInt, {
      (accum: BigInt, x: (Coll[Byte], Long)) => accum + x._2.toBigInt
    })
    val remainder = SELF.value.toBigInt - totalMinerRewards

    // Spending Path 2: pay the selected miners and keep a successor for all remaining liabilities.
    if(totalMinerRewards < SELF.value.toBigInt && remainder > 1000000L.toBigInt){
      val nextUTXO = OUTPUTS(0)
      val nextTree = nextUTXO.R4[AvlTree].get
      val nextMiners = nextUTXO.R5[Int].get
      val nextScore = nextUTXO.R6[BigInt].get
      val nextReward = nextUTXO.R7[Long].get
      val nextTokenReward = nextUTXO.R8[Long].get
      val nextBond = nextUTXO.R9[Long].get
      val nextTokens = nextUTXO.tokens.getOrElse(0, (Coll(0.toByte), 0L))
      val minerOutputBoxes = OUTPUTS.slice(1, minersWithReward.size + 1)

      val treeUpdated = {
        val removeTree = nispTree.remove(CTX_KEY_DATA, CTX_REMOVE_PROOF).get
        removeTree == nextTree
      }
      val minersRewarded = minerOutputBoxes.zip(minersWithReward).forall{
        (x: (Box, (Coll[Byte], BigInt))) =>
          blake2b256(x._1.propositionBytes) == x._2._1 &&
          x._1.value.toBigInt == x._2._2
      }
      val tokensRewarded = {
        if(tokenReward > 0L){
          minerOutputBoxes.zip(minersWithTokens).forall{
            (x: (Box, (Coll[Byte], Long))) =>
              if(x._2._2 > 0L){
                blake2b256(x._1.propositionBytes) == x._2._1 &&
                x._1.tokens(0)._1 == totalTokens._1 &&
                x._1.tokens(0)._2 == x._2._2
              }else{
                true
              }
          }
        }else{
          true
        }
      }

      val validUTXO = nextUTXO.propositionBytes == SELF.propositionBytes
      val usedReward = nextUTXO.value.toBigInt == remainder
      val usedTokens = nextTokens._1 == totalTokens._1 &&
        nextTokens._2 == totalTokens._2 - totalTokenRewards
      val usedBond = nextBond.toBigInt == totalBond.toBigInt - totalBondRefunds
      val constantsPreserved = allOf(Coll(
        totalReward == nextReward,
        totalScore == nextScore,
        currentMiners == nextMiners,
        tokenReward == nextTokenReward
      ))
      val onlyOne = SELF.id == INPUTS(0).id
      val validPartialPayout = allOf(Coll(
        validUTXO,
        usedReward,
        usedTokens,
        usedBond,
        constantsPreserved,
        treeUpdated,
        minersRewarded,
        tokensRewarded,
        onlyOne
      ))
      sigmaProp(validPartialPayout)
    }else{
      // Spending Path 3: pay the final miners and consume the Payout box.
      val minerOutputBoxes = OUTPUTS.slice(0, minersWithReward.size)
      val minersRewarded = minerOutputBoxes.zip(minersWithReward).forall{
        (x: (Box, (Coll[Byte], BigInt))) =>
          blake2b256(x._1.propositionBytes) == x._2._1 &&
          x._1.value.toBigInt >= x._2._2
      }
      val tokensRewarded = {
        if(tokenReward > 0L){
          minerOutputBoxes.zip(minersWithTokens).forall{
            (x: (Box, (Coll[Byte], Long))) =>
              if(x._2._2 > 0L){
                blake2b256(x._1.propositionBytes) == x._2._1 &&
                x._1.tokens(0)._1 == totalTokens._1 &&
                x._1.tokens(0)._2 == x._2._2
              }else{
                true
              }
          }
        }else{
          true
        }
      }
      val allBondsRefunded = totalBondRefunds == totalBond.toBigInt
      val onlyOne = SELF.id == INPUTS(0).id
      val validFinalPayout = allOf(Coll(
        allBondsRefunded,
        minersRewarded,
        tokensRewarded,
        onlyOne
      ))
      sigmaProp(validFinalPayout)
    }
  }
}
