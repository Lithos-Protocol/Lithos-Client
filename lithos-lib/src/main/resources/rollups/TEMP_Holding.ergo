{
  // TEMP Holding Contract - refundable score bond revision
  // Value: block reward plus the refundable ERG bonds of every submitted NISP.

  // REGISTERS
  // R4: NISP tree, hashed miner proposition bytes -> NISP bytes
  // R5: number of submitted miners
  // R6: sum of submitted scores
  // R7: period start
  // R8: miner hash stamped by collateral at genesis; present so R9 is contiguous
  // R9: total refundable ERG bond currently held by this rollup
  val nispTree = SELF.R4[AvlTree].get
  val currentMiners = SELF.R5[Int].get
  val totalScore = SELF.R6[BigInt].get
  val currentPeriod = SELF.R7[Long].get
  val totalBond = SELF.R9[Long].get

  // CONSTANTS
  // CONST_PERIOD_LENGTH: submission phase length
  // CONST_EVAL_PROPBYTES: hashed proposition bytes of the Evaluation contract
  // CONST_MIN_ENTRY_BOND: minimum refundable bond, 0.002 ERG at launch
  // CONST_BOND_DIVISOR: score units per nanoERG of proportional bond, 100 at launch
  val CONST_NISP_MAX = 26000
  val CONST_NISP_MIN = 7948

  // CONTEXT VARS
  // CTX_SIGNER(0): value bytes of the miner's signing proposition
  // CTX_NISP_DATA(1): hashed miner proposition bytes -> NISP bytes
  // CTX_NISP_PROOF(2): AVL insertion proof
  val CTX_SIGNER = getVar[Coll[Byte]](0).getOrElse(Coll(0.toByte))
  val CTX_NISP_DATA = getVar[(Coll[Byte], Coll[Byte])](1)
    .getOrElse((Coll(0.toByte), Coll(0.toByte)))
  val CTX_NISP_PROOF = getVar[Coll[Byte]](2).getOrElse(Coll(0.toByte))

  val nextUTXO = OUTPUTS(0)
  val nextTree = nextUTXO.R4[AvlTree].get
  val nextMiners = nextUTXO.R5[Int].get
  val nextScore = nextUTXO.R6[BigInt].get
  val nextPeriod = nextUTXO.R7[Long].get
  val nextBond = nextUTXO.R9[Long].get

  // ASSUMPTIONS
  // Collateral creates this box as output 0 with an empty all-operations AVL tree, zero miners, zero
  // score, R7 equal to the mined block height, a 32-byte miner hash in R8 and zero in R9.
  // Each AVL key is unique, so one miner can post at most one refundable bond into this rollup.
  // Wallet inputs fund the value increase. Consensus value conservation prevents the new ERG from
  // appearing without funding, while this contract pins the exact amount entering rollup custody.
  // Score-to-commitment equality is deliberately not checked here in this revision. A whitelisted
  // fraud proof removes a submission whose claimed score does not match its effective commitment.

  def bondForScore(score: Long): Long = {
    val proportional = score / CONST_BOND_DIVISOR
    if(proportional > CONST_MIN_ENTRY_BOND) proportional else CONST_MIN_ENTRY_BOND
  }

  // Spending Path 1: insert one NISP and its refundable score bond.
  if(HEIGHT < currentPeriod + CONST_PERIOD_LENGTH){
    val signerProp = executeFromVar[SigmaProp](0)
    val authenticMiner = blake2b256(signerProp.propBytes) == CTX_NISP_DATA._1
    val onlyOne = SELF.id == INPUTS(0).id
    val sameContract = nextUTXO.propositionBytes == SELF.propositionBytes
    val tokensConserved = nextUTXO.tokens == SELF.tokens
    val validNISP = {
      if(CTX_NISP_DATA._2.size > 8){
        val score = byteArrayToLong(CTX_NISP_DATA._2.slice(0, 8))
        score > 0L &&
        CTX_NISP_DATA._2.size >= CONST_NISP_MIN &&
        CTX_NISP_DATA._2.size < CONST_NISP_MAX &&
        nextScore == totalScore + score.toBigInt
      }else{
        false
      }
    }

    val score = {
      if(CTX_NISP_DATA._2.size >= 8)
        byteArrayToLong(CTX_NISP_DATA._2.slice(0, 8))
      else
        0L
    }
    val entryBond = bondForScore(score)
    val bondCollected = allOf(Coll(
      nextUTXO.value.toBigInt == SELF.value.toBigInt + entryBond.toBigInt,
      nextBond.toBigInt == totalBond.toBigInt + entryBond.toBigInt
    ))

    val treeUpdated = {
      val insertTree = nispTree.insert(Coll(CTX_NISP_DATA), CTX_NISP_PROOF).get
      insertTree == nextTree
    }
    val incrementedMiners = nextMiners == currentMiners + 1
    val samePeriod = nextPeriod == currentPeriod

    val validSubmission = allOf(Coll(
      authenticMiner,
      onlyOne,
      sameContract,
      tokensConserved,
      validNISP,
      bondCollected,
      treeUpdated,
      incrementedMiners,
      samePeriod
    ))

    sigmaProp(validSubmission) && signerProp
  }else{
    // Spending Path 2: transform into Evaluation after the submission period.
    val nextBlock = nextUTXO.R8[Long].getOrElse(0L)
    val onlyOne = SELF.id == INPUTS(0).id
    val isEvaluationContract = blake2b256(nextUTXO.propositionBytes) == CONST_EVAL_PROPBYTES
    val conservedValues = allOf(Coll(
      nextUTXO.value == SELF.value,
      nextUTXO.tokens == SELF.tokens,
      nextTree == nispTree,
      nextMiners == currentMiners,
      nextScore == totalScore,
      nextPeriod <= HEIGHT,
      nextPeriod >= currentPeriod + CONST_PERIOD_LENGTH,
      nextBlock == currentPeriod,
      nextBond == totalBond,
      onlyOne
    ))

    sigmaProp(isEvaluationContract && conservedValues)
  }
}
