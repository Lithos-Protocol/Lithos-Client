{
  // LD_T2T_DepositOrder
  // Value: the new provision box's value, the executor's ERG fee, and the ERG the reward box needs
  // A standing order to add liquidity to LD_T2T_LiquidityPool. Anyone may execute it; this checks the
  // owner received the ownership NFT of a provision at least as large as their tokens buy, and got back
  // whichever side the pool did not need. The owner may take it back at any time.
  // Adapted from ErgoDex's t2t Deposit, with a fixed executor fee in ERG.

  // TOKENS
  // 0: the pool's token X, all of it offered
  // 1: the pool's token Y, all of it offered
  // Both read inside the execution path, so a malformed box can still be refunded.

  // CONSTANTS
  // Amounts are BigInt and never cast. The compiler turns a cast constant into a second constant, and
  // every term has to be exactly one constant for orders to be built from a template.
  // CONST_REDEEMER: SigmaProp - the owner. Receives the NFT and change, and is the only key that can refund.
  // CONST_POOL_NFT: Coll[Byte] - singleton NFT of the pool this order deposits into
  // CONST_MIN_SHARES: BigInt - fewest shares the owner accepts for their tokens
  // CONST_EXECUTOR_FEE: BigInt - nanoERG the executor keeps, miner fee included
  // CONST_MAX_MINER_FEE: BigInt - most nanoERG the execution may pay to the miner fee script
  // CONST_MINER_FEE_PROP: Coll[Byte] - prop bytes of the miner fee script
  val CONST_LOCKED_LP = 0x7fffffffffffffffL

  // CONTEXT VARS
  // None of its own. POOL_OP is the pool's CTX_OP(0), read from input 0.

  // ASSUMPTIONS - statements which can be assumed to be true due to other contracts enforcing them
  // during creation of this UTXO
  // The pool NFT exists in exactly one box, under LD_T2T_LiquidityPool, which keeps it there on every
  // path. So a box at input 0 holding it is the pool, and its registers and tokens have the pool's layout.
  // Pools are created by users, so that holds only for a pool whose genesis minted a single NFT and put
  // the whole provision token supply in the pool. The client checks both before offering the pool.
  // Under its deposit operation, and only under it, the pool puts a guard-locked provision at output 1
  // with R6 naming the pool box's id and R7 the shares its reserves actually took, and mints exactly one
  // token with that id across all outputs. That is why the operation is checked: under any other, a token
  // with the pool's id can be minted and handed over while no provision names it.
  //
  // DELIBERATE OMISSIONS - conditions left out on purpose
  // The provision box's value is not pinned. It counts toward the ERG returned, because it is the owner's
  // and comes back to them on redemption.
  // Fees the pool accrued before this deposit are owed to earlier providers; the provision enters at the
  // current accumulator, which the pool pins.
  // CONST_MIN_SHARES is the only protection against a pool moved by an earlier transaction.
  // Tokens after index 1 are not carried to the reward and belong to the executor.

  val poolIn = INPUTS(0)

  // An execution puts the pool at input 0 and this box at input 1. That position is also the
  // double-satisfaction guard, since no other order can share input 1. Nothing is read from a register
  // or an output before this holds, so a refund can never fail on a read an execution needs.
  val executing = if (CONTEXT.selfBoxIndex == 1 && poolIn.tokens.size > 0) {
    poolIn.tokens(0)._1 == CONST_POOL_NFT
  } else {
    false
  }

  // Spending Path 1: Execute against the pool
  if (executing) {
    val poolOp    = getVarFromInput[Byte](0, 0).getOrElse(-1.toByte)
    val liquidity = poolIn.R4[Long].get
    val pending   = poolIn.R6[Coll[Long]].get
    val tokenX    = poolIn.tokens(1)
    val tokenY    = poolIn.tokens(2)
    val reservesX = tokenX._2 - pending(0)
    val reservesY = tokenY._2 - pending(1)
    val supplyLP  = CONST_LOCKED_LP - liquidity

    val selfX = SELF.tokens(0)
    val selfY = SELF.tokens(1)

    // Shares each side could buy on its own, the same way the pool bounds a deposit
    val minByX = selfX._2.toBigInt * supplyLP / reservesX
    val minByY = selfY._2.toBigInt * supplyLP / reservesY
    val minimalReward = min(minByX, minByY)

    // Whatever the smaller side cannot match comes back. Truncating the excess leaves the pool enough to
    // grant minimalReward from what remains.
    val excessX = if (minByX > minByY) (minByX - minByY) * reservesX / supplyLP else 0.toBigInt
    val excessY = if (minByY > minByX) (minByY - minByX) * reservesY / supplyLP else 0.toBigInt

    val provisionBox = OUTPUTS(1)
    val rewardBox    = OUTPUTS(2)

    // Change is found by id rather than position: a side with nothing to return has no entry at all
    val changeX = rewardBox.tokens.fold(0L, { (sumX: Long, t: (Coll[Byte], Long)) =>
      if (t._1 == tokenX._1) sumX + t._2 else sumX
    })
    val changeY = rewardBox.tokens.fold(0L, { (sumY: Long, u: (Coll[Byte], Long)) =>
      if (u._1 == tokenY._1) sumY + u._2 else sumY
    })

    val returnedErg = rewardBox.value + provisionBox.value

    val minerFeePaid = OUTPUTS.fold(0L, { (total: Long, o: Box) =>
      if (o.propositionBytes == CONST_MINER_FEE_PROP) total + o.value else total
    })

    val statements = allOf(Coll(
      poolOp == 1.toByte,
      selfX._1 == tokenX._1,
      selfY._1 == tokenY._1,
      // Moving the pool's price before the deposit shrinks one side's share count, and moving it back
      // afterwards takes the difference from the owner. This bounds how far the price may have moved.
      minimalReward >= CONST_MIN_SHARES,
      provisionBox.R7[Long].get >= minimalReward,
      rewardBox.propositionBytes == CONST_REDEEMER.propBytes,
      // The one token with the pool box's id, which the pool has already named in the provision's R6
      rewardBox.tokens(0)._1 == poolIn.id,
      returnedErg.toBigInt >= SELF.value.toBigInt - CONST_EXECUTOR_FEE,
      changeX.toBigInt >= excessX,
      changeY.toBigInt >= excessY,
      minerFeePaid.toBigInt <= CONST_MAX_MINER_FEE
    ))

    sigmaProp(statements)
  } else {
    // Spending Path 2: Refund
    CONST_REDEEMER
  }
}
