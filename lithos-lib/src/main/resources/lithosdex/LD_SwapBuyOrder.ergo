{
  // LD_SwapBuyOrder
  // Value: the ERG the reward box needs, which comes back to the owner with the fill
  // A standing order to sell the pool's token into LD_LiquidityPool for ERG. Anyone may execute it; this
  // checks the fill came at the pool's own price and went to the owner. The owner may take it back at
  // any time. Adapted from ErgoDex's n2t SwapBuy, with a fixed executor fee in ERG.

  // TOKENS
  // 0: the pool's token, all of it sold. Read inside the execution path, so a malformed box can still be
  // refunded.

  // CONSTANTS
  // Amounts are BigInt and never cast. The compiler turns a cast constant into a second constant, and
  // every term has to be exactly one constant for orders to be built from a template.
  // CONST_REDEEMER: SigmaProp - the owner. Receives the fill, and is the only key that can refund.
  // CONST_POOL_NFT: Coll[Byte] - singleton NFT of the pool this order trades against
  // CONST_MIN_QUOTE: BigInt - fewest nanoERG the owner gains, after the executor fee
  // CONST_EXECUTOR_FEE: BigInt - nanoERG the executor keeps out of the fill, miner fee included
  // CONST_MAX_MINER_FEE: BigInt - most nanoERG the execution may pay to the miner fee script
  // CONST_MINER_FEE_PROP: Coll[Byte] - prop bytes of the miner fee script
  val CONST_FEE_DENOM = 10000

  // CONTEXT VARS
  // None of its own. POOL_OP is the pool's CTX_OP(0), read from input 0.

  // ASSUMPTIONS - statements which can be assumed to be true due to other contracts enforcing them
  // during creation of this UTXO
  // The pool NFT exists in exactly one box, under LD_LiquidityPool, which keeps it there on every path.
  // So a box at input 0 holding it is the pool, and its registers and tokens have the pool's layout.
  // The pool's fee parameters never change, so the price quoted here is the one the pool enforces.
  //
  // DELIBERATE OMISSIONS - conditions left out on purpose
  // Nothing checks what the pool actually received. The owner is owed the pool's price for this box's
  // tokens against the pool as it stood at input 0; how the executor sources that is theirs.
  // CONST_MIN_QUOTE is the only protection against a pool moved by an earlier transaction.
  // Tokens after index 0 are not carried to the reward and belong to the executor.

  val poolIn = INPUTS(0)

  // An execution puts the pool at input 0 and this box at input 1. That position is also the
  // double-satisfaction guard, since no other order can share input 1. Nothing is read from a register
  // or an output before this holds, so a refund can never fail on a read an execution needs.
  val executing = if (CONTEXT.selfBoxIndex == 1 && poolIn.tokens.size > 0) {
    poolIn.tokens(0)._1 == CONST_POOL_NFT
  } else {
    false
  }

  // Spending Path 1: Execute against the pool
  if (executing) {
    val poolOp    = getVarFromInput[Byte](0, 0).getOrElse(-1.toByte)
    val feeParams = poolIn.R5[Coll[Long]].get
    val pending   = poolIn.R6[Coll[Long]].get
    val tokenY    = poolIn.tokens(1)
    val reservesX = poolIn.value - pending(0)
    val reservesY = tokenY._2 - pending(1)

    val baseY     = SELF.tokens(0)
    val rewardBox = OUTPUTS(1)

    // The pool sets its token-side fee aside before the curve sees an input, with the same truncation
    val soldY      = baseY._2.toBigInt
    val tradedY    = soldY - (soldY * feeParams(2)) / CONST_FEE_DENOM
    // This box's own ERG comes back to the owner, so the reward's surplus over it is the fill
    val gainX      = rewardBox.value - SELF.value
    // Everything the curve released for this order, including the executor's cut
    val quoteX     = gainX.toBigInt + CONST_EXECUTOR_FEE

    // The pool's swap inequality solved for the output, relaxed by one unit because the pool can release
    // no more than the floor of the exact amount
    val fairPrice = reservesX.toBigInt * tradedY * feeParams(0) <=
      (quoteX + 1) * (reservesY.toBigInt * CONST_FEE_DENOM + tradedY * feeParams(0))

    val minerFeePaid = OUTPUTS.fold(0L, { (total: Long, o: Box) =>
      if (o.propositionBytes == CONST_MINER_FEE_PROP) total + o.value else total
    })

    val statements = allOf(Coll(
      poolOp == 0.toByte,
      baseY._1 == tokenY._1,
      rewardBox.propositionBytes == CONST_REDEEMER.propBytes,
      gainX.toBigInt >= CONST_MIN_QUOTE,
      fairPrice,
      minerFeePaid.toBigInt <= CONST_MAX_MINER_FEE
    ))

    sigmaProp(statements)
  } else {
    // Spending Path 2: Refund
    CONST_REDEEMER
  }
}
