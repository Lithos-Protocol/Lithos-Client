{
    // Zero-coupon ERG bond: repay before maturity, or run the agreed liquidation expression.
    //
    // REGISTERS
    // R4: Coll[Byte] - originating order id, also the bond asset id
    // R5: Coll[Byte] - blake2b256 of the borrower's ErgoTree
    // R6: Coll[Long] - (repayment in nanoERG, batching fee in nanoERG)
    // R7: Int        - maturity height; repayment is open strictly below it
    // R8: Coll[Byte] - blake2b256 of the serialized liquidation expression
    //
    // CONSTANTS
    // CONST_VAULT_HASH: Coll[Byte] - blake2b256 of BondAssetVault; every settlement pays it
    //
    // TOKENS
    // tokens(0): (bond asset, 1), burned on both settlement paths
    // tokens(1..): collateral tokens
    //
    // CONTEXT VARS
    // 0: Coll[Byte] - liquidation expression; its absence selects repayment
    //
    // OUTPUTS
    // Bond at INPUTS(i): settlement at OUTPUTS(i), with R4 = SELF.id, R5 = bond asset id.
    // Repayment also returns the complete collateral to the borrower at OUTPUTS(i + 1), R4 = SELF.id.
    // Multiple repayments need filler inputs between bonds, since each uses two outputs.
    //
    // ASSUMPTIONS
    // - A verified order minted exactly two units, one here and one for the lender, and pinned the terms.
    //   This script alone does not authenticate a hand-made bond's origin or its asset's mint supply.
    // - The liquidation expression controls eligibility AND the vault's ERG and tokens. Both parties
    //   must inspect it. The bond always enforces the vault, settlement tags, and singleton burn.
    // - Anyone may repay in full; liquidation may run before maturity if the agreed expression allows it.

    // Helper Methods
    def numTokenInOutputs(tokenId: Coll[Byte]): Long = {
        OUTPUTS.fold(0L, {
            (a: Long, b: Box) =>
                val totalTokens = b.tokens.fold(0L, {
                    (z: Long, t: (Coll[Byte], Long)) => if(t._1 == tokenId) z + t._2 else z
                })
                a + totalTokens
        })
    }

    val borrowerHash     = SELF.R5[Coll[Byte]].get
    val amounts          = SELF.R6[Coll[Long]].get
    val repayment        = amounts(0)
    val maturityHeight   = SELF.R7[Int].get
    val liqScriptHash    = SELF.R8[Coll[Byte]].get
    val bondAssetId      = SELF.tokens(0)._1
    val collateralAssets = SELF.tokens.slice(1, SELF.tokens.size)
    val collateralERG    = SELF.value

    // Shared by both paths, so evaluating these eagerly costs neither path anything it does not need
    val settlementBox    = OUTPUTS(CONTEXT.selfBoxIndex)
    val toVault          = blake2b256(settlementBox.propositionBytes) == CONST_VAULT_HASH
    // R5 is what the generic vault opens with. Unpinned, a settler could name an asset of its own
    // there and claim the lender's box from the vault itself.
    val settlementTagged =
        settlementBox.R4[Coll[Byte]].get == SELF.id &&
        settlementBox.R5[Coll[Byte]].get == bondAssetId
    // The singleton must not survive the bond, or its holder could claim the lender's vault
    val assetBurned      = numTokenInOutputs(bondAssetId) == 0L

    val liquidationScript = getVar[Coll[Byte]](0)

    if (liquidationScript.isDefined) {
        val liquidated = allOf(
            Coll(
                blake2b256(liquidationScript.get) == liqScriptHash,
                toVault,
                settlementTagged,
                assetBurned
            )
        )
        sigmaProp(liquidated) && executeFromVar[SigmaProp](0)
    } else {
        // Collateral box returned to borrower. Read only here, so a liquidation of the last bond in a
        // transaction does not need an output after it.
        val returnBox = OUTPUTS(CONTEXT.selfBoxIndex + 1)
        val repaid = allOf(
            Coll(
                HEIGHT < maturityHeight,
                // RepaymentBox Conditions
                toVault,
                settlementTagged,
                settlementBox.value >= repayment,
                // ReturnBox Conditions
                blake2b256(returnBox.propositionBytes) == borrowerHash,
                returnBox.R4[Coll[Byte]].get == SELF.id,
                returnBox.tokens == collateralAssets,
                returnBox.value  >= collateralERG,
                assetBurned
            )
        )
        sigmaProp(repaid)
    }
}
