{
    // Zero-Coupon Bond Offer - a lender's standing offer to lend, closed by any borrower
    // The lender funds this box directly: everything in it is the principal, plus the ERG for the lender's
    // unit box. A borrower closes the offer by creating the exact bond the lender asked for and keeps the
    // principal. The close also mints the bond asset, a single unit for the lender: this box is INPUTS(0),
    // so the asset's id is this box's id, its genesis box ran this template, and the bond names it in R4.
    // One contract serves ERG and token loans: CONST_BOND_HASH says which bond, the box holds the principal.
    //
    // CONSTANTS
    // Every offer is this one ErgoTree template with different constants, so UIs find offers by template
    // hash and read the terms from the constants. Clients stamp offers out of the template by replacing
    // constants rather than recompiling: replacement keeps the template byte for byte by construction,
    // while a recompile keeps it only as long as the compiler lays the constants out the same way.
    // A template hash leaves every constant out, not only the terms, so verifying an offer means also
    // checking that each constant that is not a term (mintAmount among them) is the template's own.
    //
    // The lender's terms:
    // CONST_LENDER_HASH:       Coll[Byte] - blake2b256 of the lender's ErgoTree. Receives the bond asset;
    //                                       authorizes the cancel.
    // CONST_ASSET_NAME:        Coll[Byte] - EIP-4 name of the bond asset, UTF-8
    // CONST_ASSET_DESCRIPTION: Coll[Byte] - EIP-4 description of the bond asset, UTF-8
    // CONST_BOND_HASH:         Coll[Byte] - blake2b256 of the bond ErgoTree: ZC_ERG_Bond, or ZC_Token_Bond
    //                                       compiled for the repayment token. Either pays the vault.
    // CONST_REPAYMENT:         Long       - bond R6(0)
    // CONST_BATCHING_FEE:      Long       - bond R6(1)
    // CONST_MATURITY:          Int        - bond R7, an absolute height
    // CONST_LIQ_SCRIPT_HASH:   Coll[Byte] - bond R8
    // CONST_COLLATERAL_ERG:    Long       - the least nanoERG the bond may hold
    // CONST_COLLATERAL_TOKENS: Coll[(Coll[Byte], Long)] - the bond's collateral tokens, exactly
    //
    // PATHS
    // Close (SELF at INPUTS(0), the only input that can mint; asset supply exactly 1):
    //   OUTPUTS(0) lender's unit: (asset, 1) at tokens(0), script hashes to CONST_LENDER_HASH,
    //              value >= 0.001 ERG, R4-R6 = name, description, "0" (decimals), nothing from R7 on.
    //   OUTPUTS(1) bond: exactly the collateral asked for. Every register is pinned; R4 is SELF.id.
    //   Nothing else is constrained: whoever posts the collateral is the borrower, so the principal goes
    //   wherever they send it.
    // Cancel: nothing is minted, and the lender spends a box guarded by CONST_LENDER_HASH alongside.
    //
    // EIP-4
    // Indexers take a new token's name, description and decimals from the FIRST output carrying it, here
    // OUTPUTS(0). The borrower builds the close, so the lender's terms pin all three. Decimals are always
    // "0": one indivisible unit circulates. Refusing R7 also refuses R8 and R9, so a borrower cannot give
    // the asset an EIP-4 asset type, such as an NFT image link.
    //
    // ASSUMPTIONS
    // - One offer closes per transaction, since only INPUTS(0) can mint.
    // - No registers are read. Every term is compiled into this box's ErgoTree.
    // - Maturity is not compared to HEIGHT. Closing at or past maturity makes a bond that can be liquidated
    //   at once, and only the borrower who closed it loses by that.
    // - The bond and the principal are not checked against each other. A token offer whose bond repays in
    //   another token is the lender's own mistake; the client must build them as a pair.
    // - The name and description are the lender's to choose and are not checked. A wallet name is not
    //   proof of anything: verify a bond asset by the contract its genesis box ran, never by its name.
    // - The cancel authenticates the lender by co-spend, as a P2PK lender's box needs their signature.
    //   It does not constrain outputs, so a lender script anyone can spend makes the cancel anyone's.

    // Helper Methods
    def numTokenInOutputs(tokenId: Coll[Byte]): Long = {
        OUTPUTS.fold(0L, {
            (a: Long, b: Box) =>
                val totalTokens = b.tokens.fold(0L, {
                    (z: Long, t: (Coll[Byte], Long)) => if(t._1 == tokenId) z + t._2 else z
                })
                a + totalTokens
        })
    }

    // One unit, held by the lender: the bond names the asset in R4 instead of holding a unit of its own
    val mintAmount = 1L
    val minted     = numTokenInOutputs(SELF.id)

    if (minted > 0L) {
        // Close
        val lenderUnit  = OUTPUTS(0)
        val bondBox     = OUTPUTS(1)
        val bondAmounts = bondBox.R6[Coll[Long]].get

        // minted counts every output, so the unit at OUTPUTS(0) is the only one there is
        val verifiedMint =
            SELF.id == INPUTS(0).id &&
            minted == mintAmount &&
            lenderUnit.tokens.size > 0 &&
            lenderUnit.tokens(0)._1 == SELF.id &&
            blake2b256(lenderUnit.propositionBytes) == CONST_LENDER_HASH &&
            lenderUnit.value >= 1000000L

        // Lazy, so a missing or wrongly typed register is a rejection rather than an error
        val validMetadata =
            lenderUnit.R4[Coll[Byte]].get == CONST_ASSET_NAME &&
            lenderUnit.R5[Coll[Byte]].get == CONST_ASSET_DESCRIPTION &&
            lenderUnit.R6[Coll[Byte]].get == Coll(48.toByte) &&
            lenderUnit.R7[Coll[Byte]].isDefined == false

        val validBond =
            blake2b256(bondBox.propositionBytes) == CONST_BOND_HASH &&
            bondBox.tokens == CONST_COLLATERAL_TOKENS &&
            bondBox.value >= CONST_COLLATERAL_ERG

        val validTerms =
            bondBox.R4[Coll[Byte]].get == SELF.id &&
            // The borrower's own choice, but it must read as Coll[Byte], or the bond could never be spent
            // and the lender could not liquidate it
            bondBox.R5[Coll[Byte]].isDefined &&
            bondAmounts.size == 2 &&
            bondAmounts(0) == CONST_REPAYMENT &&
            bondAmounts(1) == CONST_BATCHING_FEE &&
            bondBox.R7[Int].get == CONST_MATURITY &&
            bondBox.R8[Coll[Byte]].get == CONST_LIQ_SCRIPT_HASH

        // The bond trusts its creator to have bounded the fee. Read off the bond, not the constant, so the
        // compiler cannot fold the check away and change the template.
        val feeBounded =
            bondAmounts(1) >= 0L &&
            bondBox.value - bondAmounts(1) >= 1000000L

        sigmaProp(verifiedMint && validMetadata && validBond && validTerms && feeBounded)
    } else {
        // Cancel
        val lenderAuth = INPUTS.exists { (b: Box) =>
            blake2b256(b.propositionBytes) == CONST_LENDER_HASH
        }
        sigmaProp(lenderAuth)
    }
}
