{
  // FeeRewards
  // Value: one liquidity state's externalized ERG fees, plus a refundable deposit -> 0
  // Created by the pool when a liquidity state closes. Holds that state's fees and pays each provision
  // its share, pro rata against the supply live during the state, by adding the share into the
  // provision box itself rather than paying anyone directly.
  // Any number of provision boxes may be settled in one transaction. That is the point: whoever funded
  // this box's deposit only gets it back when the last claim is made, so they need to be able to drive
  // every claim themselves without waiting on providers.

  // REGISTERS
  // R4: stateIndex (Long) - which liquidity state these fees came from
  // R5: supplyLP (Long) - total LP supply during that state, the denominator for every share
  // R6: feeInfo (Coll[Long]) - [totalFeesX, totalFeesY] for the state. Constant for this box's life, so
  // a share is always taken against the original totals however much has already been paid out.
  // R7: claimsRemaining (Long) - provisions live during the state that have not yet claimed. Reaching
  // zero is the only signal that this box may be consumed.
  // R8: depositorHash (Coll[Byte]) - hashed prop bytes of whoever funded the claim deposit.
  val stateIndex      = SELF.R4[Long].get
  val supplyLP        = SELF.R5[Long].get
  val feeInfo         = SELF.R6[Coll[Long]].get
  val claimsRemaining = SELF.R7[Long].get
  val depositorHash   = SELF.R8[Coll[Byte]].get

  val totalFeesX = feeInfo(0)
  val totalFeesY = feeInfo(1)

  // TOKENS
  // 0: provision token, amount 1. Carried so a provision box can tell a real fee box from a forgery and
  // safely let anyone spend it. Burned when this box is consumed.
  // 1: tokenY, the state's token-side fees. Absent when the state accrued none.
  val provToken = SELF.tokens(0)
  val tokenY    = SELF.tokens.getOrElse(1, (Coll(0.toByte), 0L))

  // CONSTANTS
  // CONST_PROVISION_HASH: Hashed prop bytes of the Provision contract
  // Refundable deposit funding this box's existence. Must match the pool's own constant.
  val CONST_CLAIM_DEPOSIT = 1000000L

  // CONTEXT VARS
  // CTX_OP(0): Byte, operation being performed
  // 0 - Claim - Settle one or more provision boxes.
  // CTX_CLAIMS(1): Int, how many provision boxes are being settled. They occupy inputs 1..CTX_CLAIMS,
  // each producing its successor at the matching output index. Anything after that is the claimer's own
  // funding and change.
  val CTX_OP     = getVar[Byte](0).get
  val CTX_CLAIMS = getVar[Int](1).getOrElse(0)

  // Helper Methods
  def numTokenInInputs(tokenId: Coll[Byte]): Long = {
    INPUTS.fold(0L, {
      (a: Long, b: Box) =>
        a + b.tokens.fold(0L, {
          (z: Long, t: (Coll[Byte], Long)) => if(t._1 == tokenId) z + t._2 else z
        })
    })
  }

  def numTokenInOutputs(tokenId: Coll[Byte]): Long = {
    OUTPUTS.fold(0L, {
      (a: Long, b: Box) =>
        a + b.tokens.fold(0L, {
          (z: Long, t: (Coll[Byte], Long)) => if(t._1 == tokenId) z + t._2 else z
        })
    })
  }

  // ASSUMPTIONS - statements which can be assumed to be true due to other contracts enforcing them
  // during creation of this UTXO
  // The pool set every register here at withdrawal, funded the box above its fees by the deposit, and
  // put one provision token in it
  // Deposits and redemptions are only possible on a clean fee slate, so supplyLP was constant for the
  // whole state these fees accrued in and one denominator is correct for every provision
  // The Provision contract conserves the provision amount and the owner NFT across claims, so the
  // amount read here cannot be inflated, and requires its marker to move exactly one step
  // The pool refuses a redemption unless the provision has claimed every state, so claimsRemaining can
  // always be driven to zero and the deposit is never stranded
  //
  // DELIBERATE OMISSIONS - conditions left out on purpose
  // Nobody is paid directly. A claim can be made by anyone, who has no way to know where a provision's
  // owner keeps their NFT, so the share goes into the provision box and the owner takes it out later.
  // The claimer's reward for doing the work is the deposit waiting at the end, not a cut of the fees.

  val provIns  = INPUTS.slice(1, CTX_CLAIMS + 1)
  val provOuts = OUTPUTS.slice(1, CTX_CLAIMS + 1)

  // Each provision is settled against the same state, so each is checked the same way: a real provision
  // box, not yet paid for this state, and a successor holding at least its share more than it started
  // with. The Provision contract guards its own identity and marker; this only has to pin the money.
  val allSettled = {
    if(CTX_CLAIMS > 0){
      provIns.zip(provOuts).forall{
        (x: (Box, Box)) =>
          val pIn  = x._1
          val pOut = x._2
          val provision = pIn.R6[Long].get
          val ergShare  = ((provision.toBigInt * totalFeesX.toBigInt) / supplyLP.toBigInt).toLong
          val tokShare  = ((provision.toBigInt * totalFeesY.toBigInt) / supplyLP.toBigInt).toLong
          val inY  = pIn.tokens.getOrElse(1, (Coll(0.toByte), 0L))
          val outY = pOut.tokens.getOrElse(1, (Coll(0.toByte), 0L))

          allOf(
            Coll(
              // A provision token is the whole of authentication: its supply only leaves the pool into
              // a provision box or a fee box, so a box holding one under the provision contract was
              // built by the pool and the amount in its registers was written by the deposit rules
              blake2b256( pIn.propositionBytes ) == CONST_PROVISION_HASH,
              pIn.tokens(0)._1 == provToken._1,
              pIn.tokens(0)._2 == 1L,
              // Entitlement runs from the state the provision was made in onward, which the pool
              // encoded by setting the marker one state behind. One comparison is therefore both the
              // double-claim guard and the not-yet-a-provider guard.
              pIn.R4[Long].get == stateIndex - 1L,
              pOut.R4[Long].get == stateIndex,
              // The share must actually arrive. Without this a claimer could advance a marker and keep
              // the money, since nothing else here knows what the provision was owed.
              pOut.value >= pIn.value + ergShare,
              tokShare == 0L || ( outY._1 == tokenY._1 && outY._2 >= inY._2 + tokShare )
            )
          )
      }
    }else{
      false
    }
  }

  val totalErgPaid = {
    if(CTX_CLAIMS > 0){
      provIns.zip(provOuts).fold(0L, {
        (z: Long, x: (Box, Box)) => z + (x._2.value - x._1.value)
      })
    }else{
      0L
    }
  }

  // Returned whole to whoever funded it once nothing further can be claimed. Never part of any share:
  // shares are taken against feeInfo, and this box was funded above feeInfo by exactly the deposit.
  val depositReturned = OUTPUTS.exists{
    (o: Box) =>
      blake2b256( o.propositionBytes ) == depositorHash && o.value >= CONST_CLAIM_DEPOSIT
  }

  val onlyOne = SELF.id == INPUTS(0).id

  if(CTX_OP == 0.toByte){

    // Spending Path 1: Claims remain afterwards, so this box carries on with its balance reduced
    if(claimsRemaining > CTX_CLAIMS.toLong){
      val successor = OUTPUTS(0)
      val nextY     = successor.tokens.getOrElse(1, (Coll(0.toByte), 0L))

      val carriedForward = allOf(
        Coll(
          successor.propositionBytes == SELF.propositionBytes,
          successor.tokens(0) == provToken,
          successor.tokens.size <= 2,
          successor.value >= SELF.value - totalErgPaid,
          // A token entry cannot hold zero, so a fully drained tokenY is dropped rather than zeroed
          if(tokenY._2 > 0)
            nextY._1 == tokenY._1 || nextY._2 == 0L
          else
            true,
          // The totals stay put so every share is taken against the state's original fees
          successor.R4[Long].get == stateIndex,
          successor.R5[Long].get == supplyLP,
          successor.R6[Coll[Long]].get == feeInfo,
          successor.R7[Long].get == claimsRemaining - CTX_CLAIMS.toLong,
          successor.R8[Coll[Byte]].get == depositorHash
        )
      )

      // The deposit needs no explicit guard: every share is taken against feeInfo, and this box was
      // funded above feeInfo by exactly the deposit, so what claimers may remove cannot reach it.
      sigmaProp(onlyOne && allSettled && carriedForward)

    // Spending Path 2: The last outstanding claims, so this box is consumed
    }else if(claimsRemaining == CTX_CLAIMS.toLong){
      // The provision token here must not survive. A loose one would be enough to build a counterfeit
      // provision box and drain a later fee box, so it is burned along with this box: one fewer in the
      // outputs than the inputs carried, which the surviving provision successors cannot disguise.
      val provTokenBurned = numTokenInOutputs(provToken._1) == numTokenInInputs(provToken._1) - 1L

      // Integer division leaves a little behind on every claim, and the pool may have been topped up
      // above the fees it owed. Whatever remains beyond the returned deposit goes to whoever did the
      // work of settling the last claims.
      sigmaProp(onlyOne && allSettled && depositReturned && provTokenBurned)

    }else{
      // More claims declared than are outstanding
      sigmaProp(false)
    }

  }else{
    sigmaProp(false)
  }
}
