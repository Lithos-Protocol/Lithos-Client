{
  // FeeRewards
  // Value: one liquidity state's externalized ERG fees -> 0
  // Created by the pool when a liquidity state closes. Holds that state's fees and pays each provision
  // its share, pro rata against the supply that was live during the state.
  // A claimant proves their provision by supplying the bytes of the pool box it was minted from: those
  // bytes deserialize to a box whose id must equal their provision NFT's id and which must carry the
  // pool NFT. Nothing about who is owed what is stored here, so nothing has to be kept in sync.

  // REGISTERS
  // R4: stateIndex (Long) - which liquidity state these fees came from
  // R5: supplyLP (Long) - total LP supply during that state, the denominator for every share
  // R6: feeInfo (Coll[Long]) - [totalFeesX, totalFeesY] for the state. Constant for this box's life, so
  // a share is always taken against the original totals however much has already been paid out.
  // R7: claimsRemaining (Long) - provisions live during the state that have not yet claimed. Counts
  // down, and reaching zero is the only signal that this box may be consumed.
  // R8: depositorHash (Coll[Byte]) - hashed prop bytes of whoever funded the claim deposit at
  // withdrawal. The deposit is what lets this box exist when a state closed with less in fees than a box
  // costs to hold, so that a small provision is never priced out of claiming.
  val stateIndex      = SELF.R4[Long].get
  val supplyLP        = SELF.R5[Long].get
  val feeInfo         = SELF.R6[Coll[Long]].get
  val claimsRemaining = SELF.R7[Long].get
  val depositorHash   = SELF.R8[Coll[Byte]].get

  val totalFeesX = feeInfo(0)
  val totalFeesY = feeInfo(1)

  // TOKENS
  // 0: fee NFT, minted from the pool box that closed the state. Identifies this box as genuine.
  // 1: tokenY, the state's token-side fees. Absent when the state accrued none.
  val feeNFT = SELF.tokens(0)
  val tokenY = SELF.tokens.getOrElse(1, (Coll(0.toByte), 0L))

  // CONSTANTS
  // CONST_POOL_NFT: Singleton NFT of the liquidity pool
  // CONST_PROVISION_HASH: Hashed prop bytes of the Provision contract
  // Refundable deposit funding this box's existence. Must match the pool's own constant.
  val CONST_CLAIM_DEPOSIT = 1000000L

  // Returned whole to whoever funded it, once nothing further can be claimed. Never forms part of any
  // share: shares are taken against feeInfo, which the pool funded this box above.
  val depositReturned = OUTPUTS.exists{
    (o: Box) =>
      blake2b256( o.propositionBytes ) == depositorHash && o.value >= CONST_CLAIM_DEPOSIT
  }

  // CONTEXT VARS
  // CTX_CERT_BYTES(0): Coll[Byte] serialized bytes of the pool box the claiming provision was minted
  // from. Only its recomputed id and the pool NFT inside it are trusted; the serialization form itself
  // does not matter, since the id is what is being matched.
  val CTX_CERT_BYTES = getVar[Coll[Byte]](0).get

  // INPUTS
  // 0: this box
  // 1: the claiming provision box
  val provisionBox = INPUTS(1)
  val provisionNFT = provisionBox.tokens(0)._1
  // Hashed prop bytes rather than a key, so the owner may be a contract of any size
  val ownerHash    = provisionBox.R5[Coll[Byte]].get

  // ASSUMPTIONS - statements which can be assumed to be true due to other contracts enforcing them
  // during creation of this UTXO
  // The pool set every register here at withdrawal and minted the fee NFT from its own box id
  // Deposits and redemptions are only possible on a clean fee slate, so supplyLP was constant for the
  // whole of the state these fees accrued in and one denominator is correct for every provision
  // A provision NFT exists only if the pool minted it, since its id must be the id of a box that
  // carried the pool NFT
  //
  // DELIBERATE OMISSIONS - conditions left out on purpose
  // This box does not check its own fee NFT against anything. A counterfeit fee box can be built by
  // anyone, but claiming from one only advances the claimant's own claimedThrough and costs them the
  // real claim — self-inflicted, and unreachable by anyone else since the provision box is signed.
  // Clients identify genuine fee boxes by tracing the NFT to the pool box that minted it.
  // Whether the claimant is the last one out is not knowable here beyond claimsRemaining, which is why
  // the count exists rather than inferring emptiness from the remaining balance.

  val certBox = deserializeTo[Box](CTX_CERT_BYTES)

  // The certificate is authentic when the bytes hash back to the NFT the claimant holds and the box
  // they describe carried the pool NFT. The first ties the bytes to a token that cannot be minted twice,
  // the second ties that token to this pool rather than to a box its holder built themselves.
  val authenticCert = allOf(
    Coll(
      certBox.id == provisionNFT,
      certBox.tokens(0)._1 == CONST_POOL_NFT,
      blake2b256( provisionBox.propositionBytes ) == CONST_PROVISION_HASH
    )
  )

  val provision = certBox.R8[Long].get

  // Entitlement runs from the state the provision was made in onward, which the pool encoded by
  // initialising claimedThrough one state behind. Requiring a strict advance past this box's own index
  // is therefore both the double-claim guard and the not-yet-a-provider guard in one comparison.
  val notYetClaimed = provisionBox.R4[Long].get < stateIndex
  val claimRecorded = OUTPUTS(1).R4[Long].get == stateIndex

  val ergShare = ((provision.toBigInt * totalFeesX.toBigInt) / supplyLP.toBigInt).toLong
  val tokShare = ((provision.toBigInt * totalFeesY.toBigInt) / supplyLP.toBigInt).toLong

  val ownerPaid = OUTPUTS.exists{
    (o: Box) =>
      val oTokens = o.tokens.getOrElse(0, (Coll(0.toByte), 0L))
      blake2b256( o.propositionBytes ) == ownerHash &&
      o.value >= ergShare &&
      ( tokShare == 0L || ( oTokens._1 == tokenY._1 && oTokens._2 >= tokShare ) )
  }

  val claimValid = allOf(
    Coll(
      authenticCert,
      notYetClaimed,
      claimRecorded,
      ownerPaid,
      SELF.id == INPUTS(0).id
    )
  )

  // Spending Path 1: Claims remain, so this box carries on with its balance reduced
  if(claimsRemaining > 1L){
    val successor = OUTPUTS(0)
    val nextY     = successor.tokens.getOrElse(1, (Coll(0.toByte), 0L))

    val carriedForward = allOf(
      Coll(
        successor.propositionBytes == SELF.propositionBytes,
        successor.tokens(0) == feeNFT,
        successor.tokens.size <= 2,
        successor.value >= SELF.value - ergShare,
        // A token entry cannot hold zero, so a fully drained tokenY is dropped rather than zeroed
        if(tokenY._2 - tokShare > 0)
          nextY._1 == tokenY._1 && nextY._2 >= tokenY._2 - tokShare
        else
          nextY._2 == 0L,
        // The totals stay put so every share is taken against the state's original fees
        successor.R4[Long].get == stateIndex,
        successor.R5[Long].get == supplyLP,
        successor.R6[Coll[Long]].get == feeInfo,
        successor.R7[Long].get == claimsRemaining - 1L,
        successor.R8[Coll[Byte]].get == depositorHash
      )
    )

    // The deposit needs no explicit guard here: every share is taken against feeInfo, and this box was
    // funded above feeInfo by exactly the deposit, so what a claimant may remove can never reach it.
    sigmaProp(claimValid && carriedForward)

  // Spending Path 2: The last outstanding claim, so this box is consumed
  }else if(claimsRemaining == 1L){
    // Integer division leaves a little behind on every claim, and the pool may have been topped up
    // above the fees it owed. Whatever is left beyond the returned deposit goes with the final
    // claimant rather than sitting in a box that can never be spent again.
    sigmaProp(claimValid && depositReturned)

  // Spending Path 3: The state closed with no provisions live in it, so nothing was ever claimable
  }else{
    // Reachable when every provision had been redeemed before the state closed. Without this the
    // deposit, and any fees that accrued with no one entitled to them, would sit here permanently.
    val everythingReturned = OUTPUTS.exists{
      (o: Box) =>
        blake2b256( o.propositionBytes ) == depositorHash && o.value >= SELF.value
    }
    sigmaProp(everythingReturned && SELF.id == INPUTS(0).id)
  }
}
