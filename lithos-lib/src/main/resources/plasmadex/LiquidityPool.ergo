{
  // LiquidityPool
  // Liquidity Pool storing external fees and liquidity on L2, with liquidity provisions
  // represented by an NFT
  // Much of the AMM code is taken from ErgoDex
  // https://github.com/spectrum-finance/ergo-dex/blob/master/contracts/amm/cfmm/v1/n2t/Pool.sc

  // Registers:
  // R4: liquidityTree - AVL Tree of Coll[Byte] storing NFTid -> Provision(liq: Long, feesProcessed: Long, unpaidFees: Long)
  // R5: liquidity - Can be thought of as virtual LP tokens, representation of current liquidity state
  // R6: feeParams - Coll[Long] of fee parameters as numerators divided by FeeDenom
  // First element is dex fee, second element is ERG fee, last is token fee
  // where dexFee is % of swap which is added into liquidity, and token and ERG fees are externalized fees
  // to be stored in the AVL Tree
  // R7: feeInfo - Coll[Long] of fee info represented as total tokens / ERG
  // First two elements are total fees (in ERG and tokens) collected during the current liquidity state (totalStateFeesX, totalStateFeesY)


  val liquidityTree = SELF.R4[AvlTree].get
  val liquidity = SELF.R5[Long].get
  val feeParams = SELF.R6[Coll[Long]].get
  val feeInfo   = SELF.R7[Coll[Long]].get

  val lsFeesX0 = feeInfo(0)
  val lsFeesY0 = feeInfo(1)

  val successor = OUTPUTS(0)

  val nextTree      = successor.R4[AvlTree].get
  val nextLiquidity = successor.R5[Long].get
  val nextFeeParams = successor.R6[Coll[Long]].get
  val nextFeeInfo   = successor.R7[Coll[Long]].get

  val lsFeesX1 = nextFeeInfo(0)
  val lsFeesY1 = nextFeeInfo(1)

  // CONSTANTS:
  // CONST_FEE_REWARD_HASH - Hashed prop bytes of fee reward contract

  // CONTEXT VARS:
  // CTX_OP(0): Byte representing type of operation being performed,
  // helpful for synchronization and clearer assumptions
  // 0 - Swap - Swap ERG to token or token to ERG.
  // 1 - Deposit - Add liquidity to the AMM. A new liquidity provision will be created,
  // and an NFT representing the provision will be outputted. The pool must not have any outstanding
  // liquidity state fees in feeInfo in order to perform this operation.
  // 2 - Removal - Remove liquidity from the AMM. An NFT representing the liquidity provision
  // must exist in INPUTS(1) token(0) of the tx. The entire liquidity provision will be removed and
  // the NFT will be burned. The pool must not have any outstanding liquidity state fees in feeInfo in order to
  // perform this operation.
  // 3 - Withdraw - Remove liquidity state fees from the pool and output them into a fee reward box.
  // The feeInfo register will be reset to 0.
  val CTX_OP = getVar[Byte](0).get

  // Helper Methods
  def numTokenInOutputs(tokenId: Coll[Byte]): Long = {
    OUTPUTS.fold(0L, {
      (a: Long, b: Box) =>
        val totalTokens = b.tokens.fold(0L, {
          (z: Long, t: (Coll[Byte], Long)) =>
            if(t._1 == tokenId){
              z + t._2
            }else{
              z
            }
        })
        a + totalTokens
    })
  }

  def numTokenInInputs(tokenId: Coll[Byte]): Long = {
    INPUTS.fold(0L, {
      (a: Long, b: Box) =>
        val totalTokens = b.tokens.fold(0L, {
          (z: Long, t: (Coll[Byte], Long)) =>
            if(t._1 == tokenId){
              z + t._2
            }else{
              z
            }
        })
        a + totalTokens
    })
  }
  // AMM Code
  val InitiallyLockedLP = 0x7fffffffffffffffL
  val FeeDenom = 10000
  val MinStorageRent = 10000000L  // this number of nanoErgs are going to be permanently locked

  val poolNFT0    = SELF.tokens(0)
  val reservedLP0 = liquidity
  val tokenY0     = SELF.tokens(1)


  // Dex Fee which is added back into liquidity is totalFee - (ergFee + tokenFee)
  val feeNum0 = feeParams(0)


  val poolNFT1    = successor.tokens(0)
  val reservedLP1 = nextLiquidity
  val tokenY1     = successor.tokens(1)

  val validSuccessorScript = successor.propositionBytes == SELF.propositionBytes
  val preservedFeeConfig   = feeParams == nextFeeParams

  val preservedPoolNFT     = poolNFT1 == poolNFT0
  val validY               = tokenY1._1 == tokenY0._1
  // since tokens can be repeated, we ensure for sanity that there are no more tokens
  val noMoreTokens         = successor.tokens.size == 2

  val validStorageRent     = successor.value > MinStorageRent

  val supplyLP0 = InitiallyLockedLP - reservedLP0
  val supplyLP1 = InitiallyLockedLP - reservedLP1

  val reservesX0 = SELF.value - lsFeesX0
  val reservesY0 = tokenY0._2 - lsFeesY0
  val reservesX1 = successor.value - lsFeesX1
  val reservesY1 = tokenY1._2 - lsFeesY1

  val totalDeltaX = successor.value - SELF.value
  val totalDeltaY = tokenY1._2 - tokenY0._2
  // Change in liquidity state fees
  val deltaLSFeesX = lsFeesX1 - lsFeesX0
  val deltaLSFeesY = lsFeesY1 - lsFeesY0

  val deltaSupplyLP  = supplyLP1 - supplyLP0
  val deltaReservesX = reservesX1 - reservesX0
  val deltaReservesY = reservesY1 - reservesY0

  // Validates that fee rules have been satisfied whenever a liquidity state change occurs
  // Only used in deposits and redemptions
  val validWithdraw: Boolean = {
    if(lsFeesX0 > 0 || lsFeesY0 > 0){
      val feeReward = OUTPUTS(1)
      val tokenRewarded = {
        if(lsFeesY0 > 0)
          feeReward.tokens.size == 2 && feeReward.tokens(1)._1 == tokenY0._1 &&
          feeReward.tokens(1)._2 == lsFeesY0 && totalDeltaY == -lsFeesY0
        else
          feeReward.tokens.size == 0 && totalDeltaY == 0
      }
      // Someone else can choose to fund the fee reward box if there is situation where number of ERG fees is too
      // small to create a box, but number of tokens is quite valuable. Only lsFeesX0 may be removed from LP.
      val ergRewarded = feeReward.value >= lsFeesX0 && totalDeltaX == -lsFeesX0
      val validFRBox = blake2b256(feeReward.propositionBytes) == CONST_FEE_REWARD_HASH
      val nftEmitted = feeReward.tokens.size >= 1 && feeReward.tokens(0)._1 == SELF.id
      val onlyOneNFT = numTokenInOutputs(SELF.id) == 1L
      val dictionarySame = feeReward.R4[AvlTree].get == liquidityTree
      val liquiditySame = liquidity == feeReward.R5[Long].get
      // NOTE: No fee params in fee reward contract, so R6 of feeReward maps to R7 of SELF (feeInfo register)
      val feeInfoSame = feeReward.R6[Coll[Long]].get == feeInfo
      val feesReset = lsFeesX1 == 0 && lsFeesY1 == 0
      // Preserved amm state
      val ammPreserved = deltaSupplyLP == 0 && deltaReservesX == 0 && deltaReservesY == 0
      allOf(
        Coll(
          ergRewarded,
          tokenRewarded,
          validFRBox,
          nftEmitted,
          onlyOneNFT,
          dictionarySame,
          liquiditySame,
          feeInfoSame,
          feesReset,
          ammPreserved
        )
      )
    }else{
      false
    }
  }

  val validDepositing = {

    val sharesUnlocked = min(
        deltaReservesX.toBigInt * supplyLP0 / reservesX0,
        deltaReservesY.toBigInt * supplyLP0 / reservesY0
    )
    val satisfiesAMM = deltaSupplyLP <= sharesUnlocked

    val lsFeesValid = lsFeesX0 == 0 && lsFeesY0 == 0 && deltaLSFeesX == 0 && deltaLSFeesY == 0
    // Deposit Op
    if(CTX_OP == 1){
      // Context Vars
      // CTX_PD_DATA(1) - PlasmaDex data to be inserted
      // CTX_PD_PROOF(2) - Proof of insertion
      val CTX_PD_DATA = getVar[(Coll[Byte], Coll[Byte])](1).get
      val CTX_PD_PROOF = getVar[Coll[Byte]](2).get
      val validProvisionNFT = SELF.id == CTX_PD_DATA._1
      val treeUpdated = {
        val insertTree = liquidityTree.insert(Coll(CTX_PD_DATA), CTX_PD_PROOF).get
        insertTree.digest == nextTree.digest
      }
      val validProvisionData = allOf(Coll(
        CTX_PD_DATA._2.size == 8,
        byteArrayToLong(CTX_PD_DATA._2) == deltaSupplyLP,
        byteArrayToLong(CTX_PD_DATA._2) > 0
      ))
      val nftInOutputs = numTokenInOutputs(SELF.id) == 1L
      lsFeesValid && satisfiesAMM && validProvisionNFT &&
      treeUpdated && validProvisionData && nftInOutputs
    }else{
      false
    }
  }

  val validRedemption = {

    val _deltaSupplyLP = deltaSupplyLP.toBigInt
    // note: _deltaSupplyLP, deltaReservesX and deltaReservesY are negative
    val satisfiesAMM = deltaReservesX.toBigInt * supplyLP0 >= _deltaSupplyLP * reservesX0 && deltaReservesY.toBigInt * supplyLP0 >= _deltaSupplyLP * reservesY0
    val lsFeesValid = lsFeesX0 == 0 && lsFeesY0 == 0 && deltaLSFeesX == 0 && deltaLSFeesY == 0
    // Removal Op
    if(CTX_OP == 2){
      // Context Vars
      // CTX_PD_DATA(1) - PlasmaDex data to be removed
      // CTX_LOOKUP_PROOF(2) - Proof of lookup
      // CTX_REMOVAL_PROOF(3) - Proof of removal
      val CTX_PD_DATA = getVar[Coll[Byte]](1).get
      val CTX_LOOKUP_PROOF = getVar[Coll[Byte]](2).get
      val CTX_REMOVAL_PROOF = getVar[Coll[Byte]](3).get
      val validProvisionNFT = numTokenInInputs(CTX_PD_DATA) == 1

      val lookUp = liquidityTree.get(CTX_PD_DATA, CTX_LOOKUP_PROOF).get
      val correctLiqChange = -1 * deltaSupplyLP == byteArrayToLong(lookUp)
      val treeUpdated = {
        val removeTree = liquidityTree.remove(Coll(CTX_PD_DATA), CTX_REMOVAL_PROOF).get
        removeTree.digest == nextTree.digest
      }

      val nftBurned = numTokenInOutputs(CTX_PD_DATA) == 0L

      lsFeesValid && satisfiesAMM && validProvisionNFT &&
      correctLiqChange && treeUpdated && nftBurned
    }else{
      false
    }
  }

  val validSwap = {
    // Swap ERG for token
    if (deltaReservesX > 0){
      val satisfiesAMM = reservesY0.toBigInt * deltaReservesX * feeNum0 >= -deltaReservesY * (reservesX0.toBigInt * FeeDenom + deltaReservesX * feeNum0)
      val feeXAdded = deltaLSFeesX.toBigInt == (feeParams(1).toBigInt * totalDeltaX) / FeeDenom
      val noOtherFees = deltaLSFeesY == 0
      val correctOp = CTX_OP == 0
      satisfiesAMM && feeXAdded && noOtherFees && correctOp
    } // Swap token for ERG
    else{
      val satisfiesAMM = reservesX0.toBigInt * deltaReservesY * feeNum0 >= -deltaReservesX * (reservesY0.toBigInt * FeeDenom + deltaReservesY * feeNum0)
      val feeYAdded = deltaLSFeesY.toBigInt == (feeParams(2).toBigInt * totalDeltaY) / FeeDenom
      val noOtherFees = deltaLSFeesX == 0
      val correctOp = CTX_OP == 0
      satisfiesAMM && feeYAdded && noOtherFees && correctOp
    }
  }


  val validAction = {
    if(CTX_OP == 3){
      validWithdraw
    }else{
      if (deltaSupplyLP == 0)
          validSwap
      else
          if (deltaReservesX > 0 && deltaReservesY > 0) validDepositing
          else validRedemption
   }
  }

  sigmaProp(
      validSuccessorScript &&
      preservedFeeConfig &&
      preservedPoolNFT &&
      validY &&
      noMoreTokens &&
      validAction &&
      validStorageRent
  )
}