{
  // Provision
  // Value: storage buffer plus whatever ERG fees have been claimed into it
  // One liquidity provision. Holds a single provision token, whose whole supply lives in the pool and
  // only leaves through a deposit or a fee withdrawal, so the token is proof this box was built by the
  // pool and that the amount it records is real.
  // Ownership is bearer: the box names an NFT, and anything that moves value out requires that NFT in
  // the transaction's inputs, so the right to the balance and to the underlying liquidity transfers
  // with the token and can be sold or lent against.
  // Claiming fees is the exception — anyone may do it, because a claim only ever adds to this box and
  // the person who funded a fee box needs to be able to drain it without waiting on providers.

  // REGISTERS
  // R4: claimedThrough (Long) - highest fee-box state index already claimed. Set by the pool to one
  // below the state the provision was made in.
  // R5: ownerNFT (Coll[Byte]) - id of the NFT that owns this provision, minted by the pool at deposit
  // from the pool box's own id, so it exists nowhere else.
  // R6: provision (Long) - LP shares this provision represents. Written by the pool, never changed.
  val claimedThrough = SELF.R4[Long].get
  val ownerNFT       = SELF.R5[Coll[Byte]].get
  val provision      = SELF.R6[Long].get

  // TOKENS
  // 0: provision token, amount 1
  // 1: accumulated token-side fees, added by claims and taken out by the owner
  val provToken = SELF.tokens(0)
  val balanceY  = SELF.tokens.getOrElse(1, (Coll(0.toByte), 0L))

  // CONSTANTS
  // CONST_POOL_NFT: Singleton NFT of the liquidity pool this provision belongs to
  // CONST_FEE_REWARD_HASH: Hashed prop bytes of the FeeRewards contract
  // Value floor, kept in the box so storage rent cannot reach the provision token in one sweep
  val CONST_PROVISION_MIN = 100000000L

  // CONTEXT VARS
  // CTX_OP(0): Byte, operation being performed
  // 0 - Claim    - Take one fee box's share into this box. Anyone may do this.
  // 1 - Withdraw - Move the accumulated balance out. Owner only.
  // 2 - Redeem   - Remove the liquidity from the pool and burn the owning NFT. Owner only.
  val CTX_OP = getVar[Byte](0).get

  // Positional convention: a claim spends the fee box at input 0 and any number of provision boxes
  // after it, each producing its successor at the matching output index.
  val successor = OUTPUTS(CONTEXT.selfBoxIndex)

  // Holding the NFT is the whole of ownership. It must be an *input* rather than merely referenced,
  // because an input is a box actually being spent, so whatever guards it was satisfied and its owner
  // authorised this transaction, whoever and whatever they are.
  val ownerPresent = INPUTS.exists{
    (b: Box) =>
      b.tokens.exists{ (t: (Coll[Byte], Long)) => t._1 == ownerNFT }
  }

  // The two facts no path may ever rewrite. Without them a claimer could raise the provision amount
  // between claims and drain a fee box, or repoint the box at an owner of their choosing.
  val identityHeld = allOf(
    Coll(
      successor.propositionBytes == SELF.propositionBytes,
      successor.tokens(0) == provToken,
      successor.tokens.size <= 2,
      successor.R5[Coll[Byte]].get == ownerNFT,
      successor.R6[Long].get       == provision
    )
  )

  // ASSUMPTIONS - statements which can be assumed to be true due to other contracts enforcing them
  // during creation of this UTXO
  // The pool created this box, put one provision token in it, set R4 to the state before the provision
  // was made, R5 to an NFT minted from its own box id, and R6 to the shares deposited
  // The fee contract computes each share and pins the amount that must arrive here, so this contract
  // only has to refuse a successor holding less than it started with
  // The pool refuses a redemption unless R4 has caught up to the current state, so a provision cannot
  // leave with claims outstanding and strand the fee boxes that were counting on it
  //
  // DELIBERATE OMISSIONS - conditions left out on purpose
  // The claim path checks no NFT. A claim can only ever add to this box, so there is nothing to steal by
  // performing one, and requiring the owner would leave whoever funded a fee box unable to recover their
  // deposit without every provider's cooperation.
  // Storage rent is left to the value floor rather than a refresh path or a creation-height rule. Every
  // fee state gives every provision box a reason to be spent, and each spend resets its age, so a box
  // only grows old if the pool itself has gone quiet.

  // Spending Path 1: Take one fee box's share. Permissionless.
  if(CTX_OP == 0.toByte){
    val feeBox = INPUTS(0)

    // A provision token in the counterpart is what makes this safe to open up. Its supply never leaves
    // the pool except into a provision box or a fee box, so a box holding one under the fee contract is
    // one the pool built — nobody can assemble a counterfeit to advance someone else's marker with.
    val authenticFeeBox = allOf(
      Coll(
        blake2b256( feeBox.propositionBytes ) == CONST_FEE_REWARD_HASH,
        feeBox.tokens(0)._1 == provToken._1,
        feeBox.tokens(0)._2 == 1L
      )
    )

    val claimHeld = allOf(
      Coll(
        // Exactly one step, never a jump. Monotone would let a claimer advance someone else's marker
        // past fee boxes they had not been paid from, destroying those claims on their behalf.
        successor.R4[Long].get == claimedThrough + 1L,
        // A claim adds and never subtracts. The share itself is pinned by the fee box.
        successor.value >= SELF.value,
        successor.tokens.getOrElse(1, (Coll(0.toByte), 0L))._2 >= balanceY._2
      )
    )

    sigmaProp(authenticFeeBox && identityHeld && claimHeld)

  // Spending Path 2: Owner takes the accumulated balance out
  }else if(CTX_OP == 1.toByte){
    val balanceHeld = allOf(
      Coll(
        // The floor stays behind, so the box keeps its buffer against storage rent
        successor.value >= CONST_PROVISION_MIN,
        // Withdrawing a balance is not a claim, so the marker may not move
        successor.R4[Long].get == claimedThrough
      )
    )

    sigmaProp(ownerPresent && identityHeld && balanceHeld)

  // Spending Path 3: Remove the liquidity and burn the owning NFT
  }else if(CTX_OP == 2.toByte){
    // The pool checks the liquidity removed matches R6, that every fee state has been claimed, and
    // takes the provision token back. All that is left here is the owner's authorisation and retiring
    // the NFT, so nothing is left pointing at a provision that no longer exists.
    val authenticPool = INPUTS(0).tokens(0)._1 == CONST_POOL_NFT

    val nftBurned = OUTPUTS.forall{
      (o: Box) =>
        !( o.tokens.exists{ (t: (Coll[Byte], Long)) => t._1 == ownerNFT } )
    }

    sigmaProp(ownerPresent && authenticPool && nftBurned)

  }else{
    sigmaProp(false)
  }
}
