{
  // FP_SlashedMiner
  // Value: unspecified
  // Batch-evicts miners whose authenticated MinerBond boxes have already become slashed markers.

  // REGISTERS
  // None
  val evalBox       = INPUTS(0)
  val nispTree      = evalBox.R4[AvlTree].get
  val currentMiners = evalBox.R5[Int].get
  val totalScore    = evalBox.R6[BigInt].get
  val currentPeriod = evalBox.R7[Long].get
  val currentBlock  = evalBox.R8[Long].get

  // NEXT VALUES
  val nextUTXO   = OUTPUTS(0)
  val nextTree   = nextUTXO.R4[AvlTree].get
  val nextMiners = nextUTXO.R5[Int].get
  val nextScore  = nextUTXO.R6[BigInt].get
  val nextPeriod = nextUTXO.R7[Long].get
  val nextBlock  = nextUTXO.R8[Long].get

  // DATA INPUTS
  // dataInputs(0): FP_CONTROL, authenticated by Evaluation
  // dataInputs(1): MinerDictionary, authenticated here by its singleton NFT
  // dataInputs(2..): one slashed MinerBond marker per miner key, in the same order
  val minerDictBox = CONTEXT.dataInputs(1)
  val minerDataTree = minerDictBox.R4[AvlTree].get

  // CONTEXT VARS
  // CTX_MINER_KEYS(0): distinct miner hashes to evict
  // CTX_LOOKUP_PROOF(1): batched NISP lookup proof
  // CTX_REMOVE_PROOF(2): batched NISP removal proof
  // CTX_MD_LOOKUP_PROOF(3): batched MinerDictionary lookup proof
  val CTX_MINER_KEYS = getVarFromInput[Coll[Coll[Byte]]](1, 0).getOrElse(Coll(Coll(0.toByte)))
  val CTX_LOOKUP_PROOF = getVarFromInput[Coll[Byte]](1, 1).getOrElse(Coll(0.toByte))
  val CTX_REMOVE_PROOF = getVarFromInput[Coll[Byte]](1, 2).getOrElse(Coll(0.toByte))
  val CTX_MD_LOOKUP_PROOF = getVarFromInput[Coll[Byte]](1, 3).getOrElse(Coll(0.toByte))

  // CONSTANTS
  // CONST_MD_ID: MinerDictionary singleton NFT id
  val CONST_SCORE_SIZE = 8
  val CONST_ENTRY_SIZE = 49
  val CONST_MAX_BATCH = 16

  // ASSUMPTIONS - statements which can be assumed to be true due to other contracts enforcing them
  // MinerDictionary mints two credential units and retains an exiting entry for 880 blocks.
  // MinerBond can create status 1 only by spending alongside a genuine Evaluation box and a successful
  // ordinary fraud proof. Its marker retains the credential unit and miner hash.
  // Evaluation recognizes this proof hash specially, so no active bond input is required a second time.
  //
  // DELIBERATE OMISSIONS - conditions left out on purpose
  // This proof changes only the current rollup. It does not spend markers or mutate MinerDictionary,
  // which keeps one slash independently usable against every in-flight rollup.

  val keysBounded = CTX_MINER_KEYS.size > 0 && CTX_MINER_KEYS.size <= CONST_MAX_BATCH
  val keysSized = CTX_MINER_KEYS.forall{ (k: Coll[Byte]) => k.size == 32 }
  val keysDistinct = CTX_MINER_KEYS.indices.forall{ (i: Int) =>
    val later = CTX_MINER_KEYS.slice(i + 1, CTX_MINER_KEYS.size)
    later.forall{ (k: Coll[Byte]) => k != CTX_MINER_KEYS(i) }
  }
  val markerBoxes = CONTEXT.dataInputs.slice(2, 2 + CTX_MINER_KEYS.size)
  val correctDataInputCount = CONTEXT.dataInputs.size == CTX_MINER_KEYS.size + 2

  val entryOpts = minerDataTree.getMany(CTX_MINER_KEYS, CTX_MD_LOOKUP_PROOF)
  val entries = entryOpts.map{ (e: Option[Coll[Byte]]) => e.getOrElse(Coll(0.toByte)) }
  val authenticDictionary = allOf(Coll(
    minerDictBox.tokens.getOrElse(0, (Coll(0.toByte), 0L))._1 == CONST_MD_ID,
    entryOpts.forall{ (e: Option[Coll[Byte]]) => e.isDefined },
    entries.forall{ (e: Coll[Byte]) => e.size == CONST_ENTRY_SIZE }
  ))

  val authenticMarkers = CTX_MINER_KEYS.indices.forall{ (i: Int) =>
    val marker = markerBoxes(i)
    val entry = entries(i)
    val credentialId = entry.slice(0, 32)
    val markerCredential = marker.tokens.getOrElse(0, (Coll(0.toByte), 0L))
    allOf(Coll(
      marker.R4[Coll[Byte]].get == CTX_MINER_KEYS(i),
      marker.R5[Byte].get == 1.toByte,
      marker.R6[Long].get > 0L,
      marker.R7[Coll[Byte]].isEmpty,
      marker.tokens.size == 1,
      markerCredential._1 == credentialId,
      markerCredential._2 == 1L
    ))
  }

  val nispOpts = nispTree.getMany(CTX_MINER_KEYS, CTX_LOOKUP_PROOF)
  val nispBytes = nispOpts.map{ (n: Option[Coll[Byte]]) => n.getOrElse(Coll(0.toByte)) }
  val validNisps = allOf(Coll(
    nispOpts.forall{ (n: Option[Coll[Byte]]) => n.isDefined },
    nispBytes.forall{ (n: Coll[Byte]) => n.size >= CONST_SCORE_SIZE }
  ))
  val removedScore = nispBytes.fold(0.toBigInt, {
    (a: BigInt, n: Coll[Byte]) => a + byteArrayToLong(n.slice(0, CONST_SCORE_SIZE)).toBigInt
  })
  val minerRemoved = {
    val removeTree = nispTree.remove(CTX_MINER_KEYS, CTX_REMOVE_PROOF).get
    removeTree.digest == nextTree.digest
  }
  val changedRegisters = allOf(Coll(
    nextUTXO.value == evalBox.value,
    minerRemoved,
    nextMiners == currentMiners - CTX_MINER_KEYS.size,
    nextScore == totalScore - removedScore,
    nextPeriod == currentPeriod,
    nextBlock == currentBlock
  ))
  val fraudExists = allOf(Coll(
    keysBounded,
    keysSized,
    keysDistinct,
    correctDataInputCount,
    authenticDictionary,
    authenticMarkers,
    validNisps
  ))

  sigmaProp(fraudExists && changedRegisters)
}
