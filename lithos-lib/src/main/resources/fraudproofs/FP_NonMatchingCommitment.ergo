{
  // FP_NonMatchingCommitment
  // Value: unspecified (0.001 ERG)
  // Proves fraud by showing that the score a miner submitted does not equal the difficulty commitment
  // that was in effect for them during the submission period. This is what binds a NISP's score to a
  // commitment made in advance, and so is what stops a miner from fitting their score to whichever
  // shares they happened to get lucky with.

  // REGISTERS
  // None

  val evalBox:       Box     = INPUTS(0)
  val nispTree:      AvlTree = evalBox.R4[AvlTree].get
  val currentMiners: Int     = evalBox.R5[Int].get
  val totalScore:    BigInt  = evalBox.R6[BigInt].get
  val rollupState:   Coll[Long] = evalBox.R7[Coll[Long]].get
  val currentBlock:  Long    = rollupState(1)

  // NEXT VALUES
  val nextUTXO   = OUTPUTS(0)
  val nextTree   = nextUTXO.R4[AvlTree].get
  val nextMiners = nextUTXO.R5[Int].get
  val nextScore  = nextUTXO.R6[BigInt].get

  // DATA INPUTS
  // dataInputs(0) is the FP_CONTROL box, required and authenticated by the evaluation contract
  // minerDictBox: MinerDictionary UTXO, authenticated by its singleton NFT. Needed because anyone can
  // send a box to the MinerData address, so the contract hash alone does not prove a data box is the
  // one this miner actually registered.
  // minerDataBox: MinerData UTXO of the accused miner
  val minerDictBox: Box = CONTEXT.dataInputs(1)


  // CONTEXT VARS
  // CTX_MINER_BYTES(0) - Hashed PropBytes of miner who committed fraud
  // CTX_LOOKUP_PROOF(1) - Lookup proof for miner in the NISP tree
  // CTX_REMOVE_PROOF(2) - Removal proof for miner in the NISP tree
  // CTX_MD_LOOKUP_PROOF(3) - Lookup proof for miner in the MinerDictionary tree
  val CTX_MINER_BYTES      = getVarFromInput[Coll[Byte]](1, 0).getOrElse(Coll(0.toByte))
  val CTX_LOOKUP_PROOF     = getVarFromInput[Coll[Byte]](1, 1).getOrElse(Coll(0.toByte))
  val CTX_REMOVE_PROOF     = getVarFromInput[Coll[Byte]](1, 2).getOrElse(Coll(0.toByte))
  val CTX_MD_LOOKUP_PROOF  = getVarFromInput[Coll[Byte]](1, 3).getOrElse(Coll(0.toByte))

  // ASSUMPTIONS
  // Evaluation authenticated this script and owns the rest of the transition: the box value, the bond
  // ledger, the period and the block height. This proof owns the fraud predicate, the AVL removal,
  // the miner count and the score.

  // CONSTANTS
  // CONST_MINERDATA_PROPBYTES: Hashed prop bytes of MinerData contract
  // CONST_MD_ID: Id of MinerDictionary singleton NFT
  // CONST_NISP_WINDOW: NISP window, used here as the `r` delay a commitment waits before taking effect
  val CONST_SCORE_SIZE = 8

  // ASSUMPTIONS - statements which can be assumed to be true due to other contracts enforcing them
  // currentBlock is the height the rollup's block was mined at, so the submission period ran over
  // [currentBlock, currentBlock + HOLDING_PERIOD] and this NISP was submitted somewhere inside it
  // MinerDictionary maps hashedPropBytes -> minerDataTokenId, and mints exactly one such token per miner
  // MinerData R4 holds 1 or 2 commitments, index 0 newest, and conserves R5 options on every path
  // MinerData R5 options carries the miner's hashedPropBytes in its first 32 bytes
  // A commitment is in effect once height - commitHeight >= NISP_WINDOW, evaluated at the rollup's own
  // start height. This is the rule the client submits under, and it reads the same height this proof
  // does (LFSMTransformer.getCommitmentsForNISP, called from SubmissionHandler.sendNISPSubmission)
  // MinerData spaces commitment changes far enough apart that the commitment in effect at currentBlock
  // is still held in one of the two slots for as long as the rollup can be challenged. This is what
  // lets the proof read current state and still speak about the past, and it is load-bearing. Loosen
  // that spacing and a miner can evict the governing commitment by churning, which turns this proof
  // into one that either declines or compares against the wrong score.
  // The client stamps every submitted NISP with the score committed at currentBlock, so a NISP's score
  // is the governing commitment and not the score its shares happened to be mined under
  //
  // DELIBERATE OMISSIONS - conditions left out on purpose
  // No `SELF.id == INPUTS(0).id`, the evaluation contract already enforces the input shape.

  // Helper Methods
  def getScore(nispBytes: Coll[Byte]): Long = {
    byteArrayToLong(nispBytes.slice(0,CONST_SCORE_SIZE))
  }

  // Evaluation
  val minerNISP = nispTree.get(CTX_MINER_BYTES, CTX_LOOKUP_PROOF).get
  val score: Long = getScore(minerNISP)

  // The dictionary is the only thing that tells us which data box is really this miner's, so the
  // token it recorded at registration must be the token the data box in front of us is carrying.
  val minerDataTree: AvlTree = minerDictBox.R4[AvlTree].get
  val registeredToken = minerDataTree.get(CTX_MINER_BYTES, CTX_MD_LOOKUP_PROOF)
  val authenticDictionary = minerDictBox.tokens(0)._1 == CONST_MD_ID

  if(registeredToken.isDefined){
    // MinerData box only defined if it actually exists.
    val minerDataBox: Box = CONTEXT.dataInputs(2)
    val commitments: Coll[(Int, Long)] = minerDataBox.R4[Coll[(Int, Long)]].get
    val minerHash: Coll[Byte] = minerDataBox.R5[Coll[Byte]].get.slice(0, 32)


    val authenticDataBox = allOf(
      Coll(
        blake2b256( minerDataBox.propositionBytes ) == CONST_MINERDATA_PROPBYTES,
        minerDataBox.tokens(0)._1 == registeredToken.get,
        minerHash == CTX_MINER_BYTES
      )
    )

    // The commitment that governs a NISP is the one in effect at the block the rollup was created for,
    // not the one in effect whenever the miner got around to submitting. currentBlock is already on-chain
    // in R8, so the governing commitment is fully determined here, and the miner has no say in it. Were
    // this anchored on submission instead, a miner could sit on a NISP and submit it once a new
    // commitment took effect, picking whichever of the two scores suited the shares they ended up with.
    // This is the same rule the client applies, evaluated at currentBlock rather than the current height.
    // A commitment set after currentBlock always carries a commit height beyond it, so it can never
    // satisfy the first branch. That is what stops a miner from submitting any score they like and then
    // setting a matching commitment during evaluation to escape this proof.
    // A miner holding only their registration commitment, which had not yet taken effect at currentBlock,
    // had no commitment in effect to submit under at all. The fallback score is one no NISP can carry,
    // since the holding contract only accepts a score above zero, so any submission in that state is
    // fraudulent. Returning the registration commitment instead would let a miner submit at a difficulty
    // they picked moments earlier, skipping the notice period that makes a commitment binding.
    val committedScore = {
      if(currentBlock - commitments(0)._1.toLong >= CONST_NISP_WINDOW){
        commitments(0)._2
      }else{
        commitments.getOrElse(1, (0, -1L))._2
      }
    }

    val fraudExists = allOf(
      Coll(
        authenticDictionary,
        authenticDataBox,
        score != committedScore
      )
    )

    val minerRemoved = {
      val removeTree = nispTree.remove(Coll(CTX_MINER_BYTES), CTX_REMOVE_PROOF).get
      removeTree == nextTree
    }

    val changedRegisters = allOf(
      Coll(
        minerRemoved,
        nextMiners      == currentMiners - 1,
        nextScore       == totalScore - score.toBigInt
      )
    )

    sigmaProp(fraudExists && changedRegisters)
  }else{
    // If the dictionary is authentic and we didn't find the miner in it, then by default
    // this is a fraudulent NISP
    val fraudExists = authenticDictionary

    val minerRemoved = {
      val removeTree = nispTree.remove(Coll(CTX_MINER_BYTES), CTX_REMOVE_PROOF).get
      removeTree == nextTree
    }

    val changedRegisters = allOf(
      Coll(
        minerRemoved,
        nextMiners      == currentMiners - 1,
        nextScore       == totalScore - score.toBigInt
      )
    )
    sigmaProp(fraudExists && changedRegisters)
  }
}
